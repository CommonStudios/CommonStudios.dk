---
---

<main class="window" id="main-window">
  <header class="title-bar">
    <div class="controls" aria-hidden="true">
      <span class="control-btn close" aria-hidden="true">
        <svg viewBox="0 0 10 10" class="control-icon" aria-hidden="true" focusable="false">
          <path d="M1 1L9 9M9 1L1 9" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </span>
      <span class="control-btn minimize" aria-hidden="true">
        <svg viewBox="0 0 10 10" class="control-icon" aria-hidden="true" focusable="false">
          <path d="M1 5H9" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </span>
      <span class="control-btn maximize" aria-hidden="true">
        <svg viewBox="0 0 10 10" class="control-icon" aria-hidden="true" focusable="false">
          <path d="M1 1h8v8H1z" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
    <div class="title-area"></div>
  </header>
  <slot />
</main>

<style>
  .window {
    background: var(--bg-surface);
    border-radius: 8px;
    overflow: hidden;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    border: 1px solid var(--interactive-border-hover);
    position: relative;
    z-index: 10;
    animation: windowBoot var(--duration-slow) var(--ease-out-expo) both;
    box-shadow: 0 28px 52px -28px rgba(0, 0, 0, 0.72);
    /* Allow normal page scrolling on touch devices. */
    touch-action: pan-y;
  }

  .window.rainbow {
    animation: rainbowBorder 2s linear infinite;
  }

  .window.matrix {
    animation: matrixGlitch 0.3s ease-in-out;
  }

  .window.terminal {
    border-color: rgba(0, 240, 255, 0.28);
    box-shadow:
      0 28px 52px -28px rgba(0, 0, 0, 0.72),
      0 0 0 1px rgba(0, 240, 255, 0.10),
      0 0 60px rgba(0, 240, 255, 0.12);
  }

  .window.terminal .title-bar {
    background: linear-gradient(180deg, rgba(0, 240, 255, 0.08), rgba(0, 0, 0, 0));
  }

  .window.matrix-mode {
    border-color: rgba(57, 255, 20, 0.28);
    box-shadow:
      0 28px 52px -28px rgba(0, 0, 0, 0.72),
      0 0 0 1px rgba(57, 255, 20, 0.10),
      0 0 70px rgba(57, 255, 20, 0.10);
  }

  /* Full-page Matrix background (canvas is appended to <body>) */
  :global(canvas.matrix-bg-canvas) {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    opacity: 0.34;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 12px rgba(57, 255, 20, 0.16));
  }

  .window.matrix-mode .title-bar {
    background: linear-gradient(180deg, rgba(57, 255, 20, 0.06), rgba(0, 0, 0, 0));
  }

  @keyframes windowBoot {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(20px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  @keyframes rainbowBorder {
    0% { border-color: #ff5f57; }
    17% { border-color: #febc2e; }
    33% { border-color: #28c840; }
    50% { border-color: #00f0ff; }
    67% { border-color: #a78bfa; }
    83% { border-color: #ff6b4a; }
    100% { border-color: #ff5f57; }
  }

  @keyframes matrixGlitch {
    0%, 100% { filter: none; }
    25% { filter: hue-rotate(90deg) brightness(1.2); }
    50% { filter: hue-rotate(180deg) brightness(0.8); }
    75% { filter: hue-rotate(270deg) brightness(1.1); }
  }

  .title-bar {
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--chrome-border);
  }

  .title-area {
    flex: 1;
  }

  .controls {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .control-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-fast) ease,
                opacity var(--duration-fast) ease;
    background: var(--traffic-close);
  }

  .control-btn:hover {
    transform: scale(1.15);
  }

  .control-btn:active {
    transform: scale(0.95);
  }

  .control-icon {
    width: 6px;
    height: 6px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    color: rgba(0, 0, 0, 0.7);
  }

  .minimize {
    background: var(--traffic-minimize);
  }

  .maximize {
    background: var(--traffic-maximize);
  }

  .window:hover .control-icon {
    opacity: 1;
  }

  /* Toasts (toastify-js)
   * These are created dynamically and appended to <body>, so they must be global.
   */
  :global(.toastify.tyndfed-toastify) {
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    color: inherit !important;
    font-family: var(--font-mono) !important;
    width: min(480px, calc(100vw - 48px)) !important;
    max-width: calc(100vw - 48px) !important;
  }

  :global(.tyndfed-toast) {
    position: relative;
    background: var(--bg-void);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    box-shadow:
      0 18px 48px -28px rgba(0, 0, 0, 0.85),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  :global(.tyndfed-toast)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.22);
    opacity: 1;
  }

  :global(.tyndfed-toast)::after {
    content: none;
  }

  :global(.tyndfed-toast__inner) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    padding-left: 14px;
  }

  :global(.tyndfed-toast__msg) {
    flex: 1;
    min-width: 0;
    color: var(--text-secondary);
    line-height: 1.4;
    word-break: break-word;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  :global(.tyndfed-toast__msg strong) {
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  :global(.tyndfed-toast__close) {
    flex-shrink: 0;
    appearance: none;
    border: 1px solid var(--interactive-border);
    background: var(--interactive-bg);
    color: var(--text-ghost);
    width: 28px;
    height: 28px;
    padding: 0;
    margin: -4px -6px 0 0;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--duration-fast) var(--ease-smooth),
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      opacity var(--duration-fast) ease;
    opacity: 0.85;
  }

  :global(.tyndfed-toast__close:hover) {
    background: var(--interactive-bg-hover);
    border-color: var(--interactive-border-hover);
    color: var(--text-primary);
    opacity: 1;
  }

  :global(.tyndfed-toast__close:active) {
    transform: scale(0.96);
    border-color: var(--interactive-border-active);
  }

  :global(.tyndfed-toast__close svg) {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
  }

  :global(.tyndfed-toast__progress) {
    position: absolute;
    left: 2px;
    right: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
    transform-origin: left;
    animation: tyndfedToastProgress linear forwards;
    animation-duration: var(--toast-duration, 2500ms);
    opacity: 0.9;
  }

  :global(.tyndfed-toast.tyndfed-toast--muted .tyndfed-toast__progress) {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0));
    opacity: 0.8;
  }

  @keyframes tyndfedToastProgress {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }

  :global(.tyndfed-toast .accent) {
    color: var(--accent);
    font-weight: 500;
  }

  :global(.tyndfed-toast .coral) {
    color: var(--accent-secondary);
    font-weight: 500;
  }

  :global(.tyndfed-toast .kbd) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 2px;
    vertical-align: middle;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .window {
      border-radius: 6px;
    }
  }

  @media (max-width: 480px) {
    .window {
      max-width: 100%;
      max-height: none;
      overflow: hidden;
    }

    .title-bar {
      padding: 10px 12px;
      cursor: default;
    }

    .control-btn {
      width: 10px;
      height: 10px;
    }

    .control-icon {
      width: 5px;
      height: 5px;
    }

    .controls {
      gap: 6px;
    }

    :global(.toastify.tyndfed-toastify) {
      width: calc(100vw - 32px) !important;
      max-width: calc(100vw - 32px) !important;
    }

    :global(.tyndfed-toast__inner) {
      gap: 10px;
      padding: 12px 14px;
    }

    :global(.tyndfed-toast__close) {
      width: 26px;
      height: 26px;
    }

    :global(.tyndfed-toast .kbd) {
      font-size: 10px;
      padding: 1px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window,
    .window.rainbow,
    .window.matrix {
      animation: none !important;
    }
  }
</style>

<script>
  import Toastify from 'toastify-js';
  import 'toastify-js/src/toastify.css';

  (() => {
    const mainWindow = document.getElementById('main-window');
    if (!(mainWindow instanceof HTMLElement)) {
      return;
    }

    // Astro's script type-checking can be conservative about narrowing in .astro files.
    const mainWindowEl = mainWindow;

    // Prevent duplicated listeners when this script re-runs during HMR.
    if (mainWindowEl.dataset.windowChromeInit === '1') {
      return;
    }
    mainWindowEl.dataset.windowChromeInit = '1';

    const KONAMI_CODE = [
      'ArrowUp',
      'ArrowUp',
      'ArrowDown',
      'ArrowDown',
      'ArrowLeft',
      'ArrowRight',
      'ArrowLeft',
      'ArrowRight',
      'b',
      'a'
    ];
    const KEY_BUFFER_SIZE = 24;
    const TOAST_MAX = 3;
    const TOAST_DEDUPE_WINDOW_MS = 1200;
    const HELP_MESSAGE =
      'Secrets: type <span class="kbd">tyndfed</span>, <span class="kbd">matrix</span>, <span class="kbd">rainbow</span>, <span class="kbd">ascii</span>, <span class="kbd">reset</span>. Clear: <span class="kbd">Esc</span>. Or use the <span class="accent">Konami code</span>.';

    type ToastVariant = 'secret' | 'coral' | 'muted';
    type ToastOptions = { duration?: number; variant?: ToastVariant; key?: string };

    let konamiIndex = 0;
    let isRainbowMode = false;
    let isTerminalMode = false;
    let isMatrixMode = false;
    let matrixCanvas: HTMLCanvasElement | null = null;
    let matrixRaf = 0;
    let onMatrixResize: (() => void) | null = null;

    const lastToastAtByKey = new Map<string, number>();
    const MATRIX_COLOR = 'rgba(57, 255, 20, 0.9)'; // neon green
    const MATRIX_BG_FADE = 'rgba(12, 12, 15, 0.16)'; // fade-to-black per frame
    const MATRIX_CHARS = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%&*+-=<>?';

    window.addEventListener('beforeunload', stopMatrix);

    function resolveToggleState(current: boolean, next?: boolean) {
      return typeof next === 'boolean' ? next : !current;
    }

    function resetKeyBuffer() {
      mainWindowEl.dataset.keybuf = '';
    }

    function normalizeToastKey(message: string) {
      // Key on the raw HTML message we control.
      return message.replace(/\s+/g, ' ').trim();
    }

    function clearToasts() {
      for (const el of document.querySelectorAll('.toastify.tyndfed-toastify')) {
        el.remove();
      }
      lastToastAtByKey.clear();
    }

    function showToast(message: string, durationOrOptions: number | ToastOptions = 2500) {
      const options: ToastOptions =
        typeof durationOrOptions === 'number' ? { duration: durationOrOptions } : durationOrOptions;
      const duration = options.duration ?? 2500;
      const variant = options.variant ?? 'secret';

      const key = options.key ?? normalizeToastKey(message);
      const now = Date.now();
      const lastAt = lastToastAtByKey.get(key) ?? 0;
      if (now - lastAt < TOAST_DEDUPE_WINDOW_MS) {
        return;
      }
      lastToastAtByKey.set(key, now);

      const node = document.createElement('div');
      node.className = `tyndfed-toast tyndfed-toast--${variant}`;
      node.style.setProperty('--toast-duration', `${duration}ms`);
      node.setAttribute('role', 'status');
      node.setAttribute('aria-live', 'polite');
      node.innerHTML = `
        <div class="tyndfed-toast__inner">
          <div class="tyndfed-toast__msg">${message}</div>
          <button type="button" class="tyndfed-toast__close" aria-label="Dismiss">
            <svg viewBox="0 0 10 10" aria-hidden="true" focusable="false">
              <path d="M1 1L9 9M9 1L1 9" />
            </svg>
          </button>
        </div>
        <div class="tyndfed-toast__progress" aria-hidden="true"></div>
      `;

      const toast = Toastify({
        node,
        duration,
        gravity: 'bottom',
        position: 'center',
        stopOnFocus: true,
        close: false,
        className: 'tyndfed-toastify',
      });
      const dismiss = () => toast.hideToast();

      node.addEventListener('click', (event) => {
        event.stopPropagation();
        dismiss();
      });
      (node.querySelector('.tyndfed-toast__close') as HTMLButtonElement | null)?.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
          dismiss();
        }
      );

      toast.showToast();

      const activeToasts = Array.from(document.querySelectorAll('.toastify.tyndfed-toastify'));
      while (activeToasts.length > TOAST_MAX) {
        activeToasts.shift()?.remove();
      }
    }

    function toggleTerminalMode(next?: boolean) {
      isTerminalMode = resolveToggleState(isTerminalMode, next);
      mainWindowEl.classList.toggle('terminal', isTerminalMode);
      showToast(
        isTerminalMode
          ? '<strong><span class="accent">Terminal mode</span></strong> enabled.'
          : '<strong><span class="coral">Terminal mode</span></strong> disabled.',
        { variant: isTerminalMode ? 'secret' : 'coral', duration: 2600 }
      );
    }

    function setRainbowMode(next?: boolean) {
      isRainbowMode = resolveToggleState(isRainbowMode, next);
      mainWindowEl.classList.toggle('rainbow', isRainbowMode);
      showToast(
        isRainbowMode
          ? '<strong><span class="accent">Rainbow mode</span></strong> enabled.'
          : '<strong><span class="coral">Rainbow mode</span></strong> disabled.',
        { variant: isRainbowMode ? 'secret' : 'coral', duration: 2400 }
      );
    }

    function stopMatrix() {
      if (matrixRaf) {
        cancelAnimationFrame(matrixRaf);
      }
      matrixRaf = 0;

      if (onMatrixResize) {
        window.removeEventListener('resize', onMatrixResize);
        window.visualViewport?.removeEventListener('resize', onMatrixResize);
        onMatrixResize = null;
      }

      matrixCanvas?.remove();
      matrixCanvas = null;
    }

    function startMatrix() {
      if (matrixCanvas || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      const canvas = document.createElement('canvas');
      canvas.className = 'matrix-bg-canvas';
      canvas.setAttribute('aria-hidden', 'true');
      document.body.prepend(canvas);
      matrixCanvas = canvas;

      const ctx = canvas.getContext('2d');
      if (!ctx) {
        stopMatrix();
        return;
      }

      const fontSize = 14; // CSS px, scaled by DPR in backing store
      let dpr = Math.max(1, Math.floor(window.devicePixelRatio || 1));
      let width = 0;
      let height = 0;
      let columns = 0;
      let drops: number[] = [];

      const resize = () => {
        if (!matrixCanvas) {
          return;
        }

        dpr = Math.max(1, Math.floor(window.devicePixelRatio || 1));
        width = Math.max(1, Math.floor(window.innerWidth));
        height = Math.max(1, Math.floor(window.innerHeight));
        matrixCanvas.width = width * dpr;
        matrixCanvas.height = height * dpr;
        matrixCanvas.style.width = `${width}px`;
        matrixCanvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        columns = Math.max(1, Math.floor(width / fontSize));
        drops = Array.from({ length: columns }, () => Math.floor(Math.random() * (height / fontSize)));
        ctx.font = `${fontSize}px JetBrains Mono, monospace`;
        ctx.textBaseline = 'top';
      };

      resize();

      onMatrixResize = () => resize();
      window.addEventListener('resize', onMatrixResize, { passive: true });
      window.visualViewport?.addEventListener('resize', onMatrixResize, { passive: true });

      let lastFrameTime = 0;
      const frameInterval = 1000 / 30; // ~30fps

      const draw = (time: number) => {
        if (!matrixCanvas) {
          return;
        }
        if (document.hidden) {
          matrixRaf = requestAnimationFrame(draw);
          return;
        }

        if (time - lastFrameTime >= frameInterval) {
          lastFrameTime = time;
          ctx.fillStyle = MATRIX_BG_FADE;
          ctx.fillRect(0, 0, width, height);

          ctx.fillStyle = MATRIX_COLOR;
          for (let i = 0; i < columns; i++) {
            const ch = MATRIX_CHARS[Math.floor(Math.random() * MATRIX_CHARS.length)];
            const x = i * fontSize;
            const y = drops[i] * fontSize;
            ctx.fillText(ch, x, y);

            if (y > height && Math.random() > 0.975) {
              drops[i] = 0;
            } else {
              drops[i] += 1;
            }
          }
        }

        matrixRaf = requestAnimationFrame(draw);
      };

      matrixRaf = requestAnimationFrame(draw);
    }

    function setMatrixMode(next?: boolean) {
      isMatrixMode = resolveToggleState(isMatrixMode, next);
      mainWindowEl.classList.toggle('matrix-mode', isMatrixMode);
      document.body.classList.toggle('matrix-mode', isMatrixMode);
      if (isMatrixMode) {
        startMatrix();
      } else {
        stopMatrix();
      }

      showToast(
        isMatrixMode
          ? '<strong><span class="accent">Matrix mode</span></strong> enabled.'
          : '<strong><span class="coral">Matrix mode</span></strong> disabled.',
        { variant: isMatrixMode ? 'secret' : 'coral', duration: 2400 }
      );
    }

    function hardReset(message: string) {
      isMatrixMode = false;
      isRainbowMode = false;
      isTerminalMode = false;
      konamiIndex = 0;
      resetKeyBuffer();

      mainWindowEl.classList.remove('matrix-mode', 'rainbow', 'terminal', 'matrix');
      document.body.classList.remove('matrix-mode');
      stopMatrix();
      clearToasts();
      showToast(message, { variant: 'muted', duration: 1600 });
    }

    function maybeHandleTypedCode(nextBuffer: string) {
      if (nextBuffer.endsWith('tyndfed')) {
        toggleTerminalMode();
        resetKeyBuffer();
        return;
      }
      if (nextBuffer.endsWith('ascii')) {
        showToast('<strong><span class="accent">ASCII forever</span></strong>.', {
          variant: 'secret',
          duration: 2400,
        });
        window.dispatchEvent(new CustomEvent('tyndfed:glitch'));
        resetKeyBuffer();
        return;
      }
      if (nextBuffer.endsWith('matrix')) {
        setMatrixMode();
        resetKeyBuffer();
        return;
      }
      if (nextBuffer.endsWith('rainbow')) {
        setRainbowMode();
        resetKeyBuffer();
        return;
      }
      if (nextBuffer.endsWith('reset')) {
        hardReset('<strong><span class="accent">Reset</span></strong> complete.');
      }
    }

    function handleKonamiKey(key: string) {
      if (key === KONAMI_CODE[konamiIndex]) {
        konamiIndex += 1;
        if (konamiIndex !== KONAMI_CODE.length) {
          return;
        }

        konamiIndex = 0;
        if (isRainbowMode) {
          setRainbowMode(false);
          showToast('<strong><span class="coral">Secret</span></strong> deactivated.', {
            variant: 'coral',
            duration: 1900,
          });
          return;
        }

        setRainbowMode(true);
        mainWindowEl.classList.add('matrix');
        setTimeout(() => mainWindowEl.classList.remove('matrix'), 300);
        showToast('<strong><span class="accent">Konami code</span></strong>: secret mode activated!', {
          variant: 'secret',
          duration: 2600,
        });
        return;
      }

      konamiIndex = 0;
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === '?') {
        showToast(HELP_MESSAGE, { variant: 'secret', duration: 4200 });
        return;
      }

      if (event.key === 'Escape' || event.key === 'Esc') {
        hardReset('<strong><span class="coral">Cleared</span></strong>.');
        return;
      }

      handleKonamiKey(event.key);

      // Typed word codes (ignore modifier combos).
      if (event.ctrlKey || event.metaKey || event.altKey || event.key.length !== 1) {
        return;
      }

      const key = event.key.toLowerCase();
      if (!/^[a-z0-9]$/.test(key)) {
        return;
      }

      const existing = mainWindowEl.dataset.keybuf ?? '';
      const nextBuffer = (existing + key).slice(-KEY_BUFFER_SIZE);
      mainWindowEl.dataset.keybuf = nextBuffer;
      maybeHandleTypedCode(nextBuffer);
    });
  })();
</script>
