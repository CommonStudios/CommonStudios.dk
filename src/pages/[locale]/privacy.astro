---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LegalSection from '~/components/LegalSection.astro';
import { legalContent } from '~/data/legal';
import { LOCALES, isLocale } from '~/i18n/constants';
import { ui } from '~/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) {
  return Astro.redirect('/da/privacy');
}
const locale = raw;
const t = ui(locale);
const legal = legalContent[locale];
---

<BaseLayout
  title={t.meta.privacyTitle}
  description={t.meta.privacyDescription}
  locale={locale}
  segment="privacy"
>
  <div class="legal wrap">
    <h1>{t.privacy.title}</h1>
    <LegalSection document={legal.privacy} />
    <LegalSection document={legal.terms} />
  </div>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  h1 {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
