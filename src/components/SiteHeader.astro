---
import { ROUTES } from '~/config/site';

type NavLink = { label: string; href: string; external?: boolean };
const navLinks: NavLink[] = [
  { label: 'Index', href: ROUTES.projects },
  { label: 'Contact', href: 'mailto:kontakt@tyndfed.dk', external: true },
];
---

<header class="site-header" data-site-header>
  <div class="shell site-header-inner">
    <a href={ROUTES.home} class="brand" aria-label="Tyndfed — back to home">
      <span class="brand-name">Tyndfed</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: none;
    background: rgba(10, 10, 9, 0.94);
    border-bottom: 1px solid var(--rule);
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding-block: 16px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--text-primary);
    width: fit-content;
  }

  .brand-name {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.02em;
  }

  .site-nav ul {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 20px;
  }

  .site-nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 0;
    border: none;
    background: transparent;
    transition: color var(--duration-fast) ease;
  }

  .site-nav a:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 480px) {
    .site-header-inner {
      gap: 12px;
      padding-block: 14px;
    }

    .brand-name {
      font-size: 16px;
    }

    .site-nav ul {
      gap: 12px;
    }
  }
</style>
