---
import type { LegalDocument } from '~/data/legal';

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
---

<section class="legal-section">
  <header class="ls-head">
    <h2>{document.title}</h2>
    <p class="updated">{document.updated}</p>
  </header>
  <div class="ls-body">
    {document.sections.map((section) => (
      <article class="ls-block">
        <h3>{section.heading}</h3>
        <p>{section.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .legal-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    padding-bottom: 24px;
  }

  .ls-head {
    position: sticky;
    top: 100px;
    align-self: start;
    border-top: 1px solid var(--rule-strong);
    padding-top: 16px;
  }

  .ls-head h2 {
    font-family: var(--font-display);
    font-weight: 520;
    font-variation-settings: normal;
    font-size: 36px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--text-primary);
    margin: 0;
  }

  .updated {
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .updated::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  .ls-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 16px;
  }

  .ls-block h3 {
    font-family: var(--font-display);
    font-weight: 560;
    font-variation-settings: normal;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .ls-block p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 70ch;
  }

  @media (max-width: 768px) {
    .legal-section {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .ls-head {
      position: static;
    }
  }
</style>
