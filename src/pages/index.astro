---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import ContactInfo from '~/components/ContactInfo.astro';
import StarBorder from '~/components/StarBorder';
import { AsciiLogo } from '~/components/AsciiLogo';
import { CANONICAL } from '~/config/site';
---

<BaseLayout
  title="Tyndfed - Software Development & Creative Services"
  canonical={CANONICAL.home}
>
  <WindowChrome>
    <div class="home-content window-scroll-region">
      <AsciiLogo client:idle />
      <p class="tagline">Software development & creative services</p>
      <footer class="footer">
        <nav>
          <StarBorder
            as="a"
            href="/projects"
            className="hero-star-border"
            color="#ff4fd8"
            speed="5s"
            thickness={1}
            aria-label="View projects"
            data-astro-prefetch
          >
            <span class="hero-star-border-prompt">$</span>
            <span class="hero-star-border-command">view-projects</span>
            <span class="hero-star-border-cursor"></span>
          </StarBorder>
        </nav>
        <SocialLinks />
        <ContactInfo />
      </footer>
    </div>
  </WindowChrome>
</BaseLayout>

<style>
  .tagline {
    text-align: center;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    padding: 0 24px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    line-height: 1.5;
  }

  .tagline::before,
  .tagline::after {
    content: '';
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--chrome-border-strong));
    flex-shrink: 0;
  }

  .tagline::after {
    background: linear-gradient(90deg, var(--chrome-border-strong), transparent);
  }

  .footer {
    text-align: center;
    padding: 36px 24px 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .footer nav {
    margin: 0;
  }

  :global(.hero-star-border) {
    display: inline-block;
    text-decoration: none;
  }

  :global(.hero-star-border .inner-content) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: 12px 18px;
    color: var(--text-secondary);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      rgba(7, 10, 18, 0.92);
    border: 1px solid rgba(255, 79, 216, 0.2);
    border-radius: 20px;
    box-shadow:
      0 16px 34px -22px rgba(0, 0, 0, 0.7),
      inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    transition:
      transform var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-normal) var(--ease-smooth),
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  :global(.hero-star-border:hover .inner-content) {
    transform: translateY(-1px);
    color: var(--text-primary);
    border-color: rgba(255, 79, 216, 0.42);
    background:
      linear-gradient(180deg, rgba(255, 79, 216, 0.1), rgba(255, 255, 255, 0)),
      rgba(7, 10, 18, 0.96);
    box-shadow:
      0 20px 40px -24px rgba(0, 0, 0, 0.76),
      0 0 24px rgba(255, 79, 216, 0.16);
  }

  :global(.hero-star-border:active .inner-content) {
    transform: translateY(0);
  }

  :global(.hero-star-border:focus-visible .inner-content) {
    border-color: rgba(255, 79, 216, 0.58);
    box-shadow:
      0 0 0 1px rgba(255, 79, 216, 0.42),
      0 0 0 6px rgba(255, 79, 216, 0.14);
  }

  :global(.hero-star-border-prompt) {
    color: var(--accent);
    font-weight: 600;
  }

  :global(.hero-star-border-command) {
    color: inherit;
    transition: color var(--duration-fast) ease;
  }

  :global(.hero-star-border-cursor) {
    width: 7px;
    height: 14px;
    background: var(--accent);
    opacity: 0.35;
    animation: blink 1s step-end infinite;
    transition: opacity var(--duration-fast) ease;
  }

  :global(.hero-star-border:hover .hero-star-border-cursor) {
    opacity: 0.9;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (max-width: 768px) {
    .tagline::before,
    .tagline::after {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .tagline {
      font-size: var(--font-size-sm);
      padding: 0 16px;
      letter-spacing: 0.05em;
      gap: 12px;
      text-align: center;
    }

    .tagline::before,
    .tagline::after {
      width: 16px;
    }

    .footer {
      padding: 24px 16px 30px;
      gap: 20px;
    }

    .footer nav {
      width: 100%;
    }

    :global(.hero-star-border) {
      display: block;
      width: 100%;
    }

    :global(.hero-star-border .inner-content) {
      width: 100%;
      justify-content: center;
      padding: 11px 16px;
    }
  }
</style>
