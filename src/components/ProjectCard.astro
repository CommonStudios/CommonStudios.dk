---
import type { Project } from '~/data/projects';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
---

<article class="project" data-card-glow>
  <header class="project-header">
    <img
      src={project.icon}
      alt={`${project.name} logo`}
      class="project-icon"
      data-card-icon
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="64"
      height="64"
    />
    <h3 class="project-title">{project.name}</h3>
  </header>
  <p class="project-description">{project.description}</p>
  <div class="project-links">
    {project.links.map((link) => {
      const isExsLogoPreview =
        project.name === 'EXS Nordic' && (link.label === 'Logo (hvid)' || link.label === 'Logo (sort)');

      return isExsLogoPreview ? (
        <button
          type="button"
          class="project-link project-link-button"
          data-image-window-trigger
          data-image-window-title={`${project.name} - ${link.label}`}
          data-image-window-src={link.url}
          aria-label={`${project.name} - ${link.label} (opens logo preview window)`}
        >
          → {link.label}
        </button>
      ) : (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.name} - ${link.label} (opens in a new tab)`}
          class="project-link"
        >
          → {link.label}
        </a>
      );
    })}
  </div>
</article>

<style>
  .project {
    --pointer-x: 50%;
    --pointer-y: 30%;
    --lift: 0px;
    --glow-rgb: 0, 240, 255;
    --glow-soft-rgb: 167, 139, 250;
    padding: 22px;
    background: var(--bg-elevated);
    border: 1px solid rgba(var(--glow-rgb), 0.16);
    border-radius: 8px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transform: translateY(var(--lift));
    transition:
      transform var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .project::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      240px circle at var(--pointer-x) var(--pointer-y),
      rgba(var(--glow-rgb), 0.94) 0%,
      rgba(var(--glow-soft-rgb), 0.64) 30%,
      rgba(var(--glow-rgb), 0.26) 54%,
      transparent 78%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.52;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--duration-fast) ease;
  }

  .project > * {
    position: relative;
    z-index: 1;
  }

  .project:hover {
    --lift: -2px;
    border-color: rgba(var(--glow-rgb), 0.44);
    background: var(--bg-elevated);
  }

  .project:hover::after {
    opacity: 1;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .project-icon {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid var(--chrome-border);
  }

  .project-title {
    color: var(--text-primary);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .project-description {
    color: var(--text-secondary);
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  .project-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .project-link {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: 7px 12px;
    background: var(--interactive-bg);
    border: 1px solid var(--interactive-border);
    border-radius: 5px;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-normal) var(--ease-smooth);
  }

  .project-link:hover {
    color: var(--text-primary);
    border-color: var(--interactive-border-hover);
    background: var(--interactive-bg-hover);
    box-shadow: var(--interactive-shadow);
    transform: translateY(-1px);
  }

  .project-link:active {
    transform: translateY(0);
    border-color: var(--interactive-border-active);
  }

  .project-link:focus-visible {
    border-color: var(--interactive-border-active);
    box-shadow: var(--interactive-shadow-strong);
  }

  .project-link-button {
    font-family: inherit;
    line-height: 1.2;
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .project {
      padding: 16px;
    }

    .project-icon {
      width: 52px;
      height: 52px;
    }

    .project-links {
      flex-direction: column;
      gap: 8px;
    }

    .project-link {
      width: 100%;
      text-align: center;
      justify-content: center;
      font-size: var(--font-size-xs);
      min-height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project {
      transform: translateY(var(--lift));
    }

    .project::after {
      transition: none;
    }
  }
</style>
