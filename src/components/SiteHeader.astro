---
import { BRAND_MARK_SRC } from '~/config/site';
import type { Locale } from '~/i18n/constants';
import { DEFAULT_LOCALE } from '~/i18n/constants';
import { pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

type Segment = '' | 'projects' | 'privacy' | 'contact';

interface Props {
  locale?: Locale;
  segment?: Segment;
}

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const segment: Segment = Astro.props.segment ?? '';
const t = ui(locale);
---

<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a href={pathForLocale(locale, '')} class="brand" aria-label={t.header.brandAria}>
      <img src={BRAND_MARK_SRC} alt="" width="220" height="58" class="brand-mark" />
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-label={t.header.navPrimary}
      aria-expanded="false"
      aria-controls="site-header-menu"
      data-menu-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="site-header-end" id="site-header-menu" data-menu-panel>
      <nav class="site-nav" aria-label={t.header.navPrimary}>
        <ul>
          <li>
            <a
              href={pathForLocale(locale, 'projects')}
              class:list={['site-nav-link', { 'is-current': segment === 'projects' }]}
              aria-current={segment === 'projects' ? 'page' : undefined}
            >
              {t.header.projects}
            </a>
          </li>
          <li>
            <a
              href={pathForLocale(locale, 'contact')}
              class:list={['site-nav-link', { 'is-current': segment === 'contact' }]}
              aria-current={segment === 'contact' ? 'page' : undefined}
            >
              {t.header.contact}
            </a>
          </li>
        </ul>
      </nav>

      <div class="locale-switch" role="group" aria-label={t.header.chooseLanguage} data-active={locale}>
        <span class="locale-pill" aria-hidden="true"></span>
        <a
          href={pathForLocale('da', segment)}
          class:list={['locale-link', { 'is-active': locale === 'da' }]}
          aria-current={locale === 'da' ? 'page' : undefined}
          lang="da"
        >
          DA
        </a>
        <a
          href={pathForLocale('en', segment)}
          class:list={['locale-link', { 'is-active': locale === 'en' }]}
          aria-current={locale === 'en' ? 'page' : undefined}
          lang="en"
        >
          EN
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    z-index: 100;
    width: 100%;
  }

  .site-header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    min-width: 0;
  }

  .site-header-end {
    display: flex;
    align-items: center;
    gap: 16px 22px;
    flex-wrap: nowrap;
    justify-content: flex-end;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--text-primary);
    width: fit-content;
    line-height: 0;
  }

  .brand-mark {
    width: auto;
    height: 38px;
    display: block;
  }

  .menu-toggle {
    display: none;
    appearance: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: rgba(247, 247, 242, 0.03);
    color: var(--text-primary);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    padding: 0;
    transition:
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .menu-toggle:hover {
    border-color: var(--accent);
    background: rgba(247, 247, 242, 0.06);
  }

  .menu-toggle span {
    width: 16px;
    height: 1px;
    background: currentColor;
    transform-origin: center;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .site-header[data-menu-open='true'] .menu-toggle span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header[data-menu-open='true'] .menu-toggle span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-menu-open='true'] .menu-toggle span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .site-nav {
    flex-shrink: 0;
  }

  .site-nav ul {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 20px;
    white-space: nowrap;
  }

  .site-nav-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 7px 0;
    border: none;
    background: transparent;
    transition: color var(--duration-fast) ease;
  }

  .site-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    height: 1px;
    background: currentColor;
    opacity: 0;
    transform: scaleX(0.6);
    transform-origin: left center;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .site-nav-link:hover {
    color: var(--accent-strong);
  }

  .site-nav-link:hover::after,
  .site-nav-link.is-current::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-nav-link.is-current {
    color: var(--text-primary);
  }

  .locale-switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    padding: 4px;
    gap: 4px;
    border-radius: 8px;
    border: 1px solid rgba(247, 247, 242, 0.18);
    background: rgba(0, 0, 0, 0.34);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    flex-shrink: 0;
    min-width: 7.5rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 10px 26px -22px rgba(0, 0, 0, 0.9);
  }

  .locale-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 6px);
    background: var(--text-primary);
    border-radius: 5px;
    z-index: 0;
    transform: translateX(0);
    transition: transform 0.38s var(--ease-out-expo);
    pointer-events: none;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.2),
      0 8px 18px -12px rgba(255, 255, 255, 0.36);
  }

  .locale-switch[data-active='en'] .locale-pill {
    transform: translateX(calc(100% + 4px));
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-pill,
    .locale-link {
      transition: color 0.15s ease;
    }
  }

  .locale-link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border-radius: 5px;
    color: var(--text-secondary);
    transition: color 0.24s ease;
    border-bottom: none;
  }

  .locale-link:focus-visible {
    outline: 1px solid var(--text-primary);
    outline-offset: 2px;
    border-radius: 5px;
  }

  .locale-link:hover {
    color: var(--text-primary);
  }

  .locale-link.is-active {
    color: var(--bg-void);
  }

  @media (max-width: 480px) {
    .site-header {
      position: relative;
    }

    .site-header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
    }

    .brand-mark {
      height: 26px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-header-end {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      width: 100%;
      display: grid;
      gap: 14px;
      justify-content: stretch;
      padding: 14px;
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: color-mix(in oklch, var(--bg-surface) 94%, transparent);
      box-shadow: 0 18px 48px -28px rgba(0, 0, 0, 0.85);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-6px);
      transition:
        opacity var(--duration-fast) ease,
        transform var(--duration-fast) ease;
      z-index: 20;
    }

    .site-header[data-menu-open='true'] .site-header-end {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-nav ul {
      display: grid;
      gap: 6px;
      white-space: normal;
    }

    .site-nav-link {
      display: block;
      padding: 10px 0;
      font-size: 12px;
    }

    .locale-switch {
      width: 100%;
      min-width: 0;
    }

    .locale-link {
      min-height: 38px;
      padding: 8px;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const headers = document.querySelectorAll('[data-site-header]');

    headers.forEach((header) => {
      const toggle = header.querySelector('[data-menu-toggle]');
      if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) {
        return;
      }

      const setOpen = (open) => {
        header.dataset.menuOpen = String(open);
        toggle.setAttribute('aria-expanded', String(open));
      };

      setOpen(false);

      toggle.addEventListener('click', () => {
        setOpen(header.dataset.menuOpen !== 'true');
      });

      header.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof HTMLAnchorElement) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(false);
        }
      });
    });
  })();
</script>
