---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT } from '~/config/site';
import { projects } from '~/data/projects';
import { LOCALES, isLocale } from '~/i18n/constants';
import { ui } from '~/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) {
  return Astro.redirect('/da');
}
const locale = raw;
const t = ui(locale);
const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<BaseLayout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  locale={locale}
  segment=""
  asciiBrand
>
  <section class="intro wrap">
    <h1>{t.home.title}</h1>
    <p>{t.home.intro}</p>
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-heading">{t.home.workHeading}</h2>
    <ul class="work" role="list">
      {projects.map((project) => (
        <li class="work-item">
          <h3 class="work-name">
            <a href={project.url} rel="noopener" target="_blank">{project.name}</a>
          </h3>
          <div class="work-body">
            {project.icon && (
              <img
                class="work-icon"
                src={project.icon}
                width="48"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <p>{project.description[locale]}</p>
            {project.preview && (
              <img
                class="work-preview"
                src={project.preview.src}
                width={project.preview.width}
                height={project.preview.height}
                alt={project.preview.alt[locale]}
                loading="lazy"
                decoding="async"
              />
            )}
            <p class="work-host" aria-hidden="true">{hostname(project.url)}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="services-heading">
    <h2 id="services-heading" class="section-heading">{t.home.servicesHeading}</h2>
    <ul class="services" role="list">
      {t.home.services.map((service) => (
        <li>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="section contact wrap" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-heading">{t.home.contactHeading}</h2>
    <p class="contact-text">{t.home.contactText}</p>
    <div class="contact-actions">
      <a class="contact-email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <button
        type="button"
        class="copy"
        aria-live="polite"
        data-copy={CONTACT.email}
        data-copied-label={t.home.copiedEmail}
      >
        {t.home.copyEmail}
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const idleLabel = button.textContent ?? '';
    let resetTimer = 0;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        // Clipboard blocked: the mailto link next to the button still works.
        return;
      }
      button.textContent = button.dataset.copiedLabel ?? idleLabel;
      button.dataset.state = 'copied';
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.textContent = idleLabel;
        delete button.dataset.state;
      }, 2000);
    });
  }
</script>

<style>
  .intro {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 10vw, 8rem);
  }

  h1 {
    max-width: 20ch;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .intro p {
    max-width: var(--measure);
    margin-top: 1.5rem;
    color: var(--lichen);
  }

  .section {
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .section-heading {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--lichen);
    padding-bottom: 1rem;
  }

  /* --- Work: the one loud element. Names set large, rows fully clickable. --- */

  .work-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1rem 3rem;
    align-items: start;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid var(--seam);
  }

  .work-item:last-child {
    border-bottom: 1px solid var(--seam);
  }

  .work-name {
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .work-name a {
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  /* Stretch the name link over the whole row. */
  .work-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-item:hover .work-name a {
    color: var(--patina);
  }

  .work-name a:focus-visible {
    outline: none;
  }

  .work-name a:focus-visible::after {
    outline: 2px solid var(--patina);
    outline-offset: -2px;
  }

  .work-body {
    max-width: var(--measure);
    padding-top: 0.5rem;
    color: var(--lichen);
  }

  .work-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 1.25rem;
    border-radius: 11px;
    /* Separates dark-ground icons from the page without a visible box. */
    box-shadow: 0 0 0 1px var(--seam-strong);
  }

  .work-preview {
    width: min(16rem, 100%);
    margin-top: 1.5rem;
  }

  .work-host {
    margin-top: 1rem;
    color: var(--paper);
  }

  /* --- Services --- */

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2.5rem 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--seam);
    list-style: none;
  }

  .services h3 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .services p {
    max-width: var(--measure);
    margin-top: 0.75rem;
    color: var(--lichen);
  }

  /* --- Contact --- */

  .contact .section-heading {
    font-size: var(--step-2);
    color: var(--paper);
    letter-spacing: -0.02em;
    padding-bottom: 0;
  }

  .contact-text {
    max-width: var(--measure);
    margin-top: 1rem;
    color: var(--lichen);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }

  .contact-email {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration-color: var(--seam-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .contact-email:hover {
    text-decoration-color: currentColor;
  }

  .copy {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--seam-strong);
    border-radius: 999px;
    background: none;
    color: var(--paper);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition:
      border-color var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .copy:hover {
    border-color: var(--patina);
    color: var(--patina);
  }

  .copy[data-state='copied'] {
    border-color: var(--patina);
    background: var(--patina);
    color: var(--oxide);
  }

  @media (max-width: 52rem) {
    .work-item {
      grid-template-columns: 1fr;
    }

    .work-body {
      padding-top: 0;
    }
  }
</style>
