---
const STORAGE = 'tyndfed-lang';
const suffix = '/contact';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Tyndfed — Contact</title>
    <link rel="icon" type="image/svg+xml" href="/images/tyndfed.svg" />
    <script is:inline define:vars={{ STORAGE, suffix }}>
      (function () {
        function pick() {
          try {
            var s = localStorage.getItem(STORAGE);
            if (s === 'da' || s === 'en') return s;
          } catch (_) {}
          var nav = navigator.language || '';
          return nav.toLowerCase().startsWith('da') ? 'da' : 'en';
        }
        location.replace('/' + pick() + suffix);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <p>
        <a href="/da/contact">Dansk</a>
        <span aria-hidden="true"> · </span>
        <a href="/en/contact">English</a>
      </p>
    </noscript>
  </body>
</html>
