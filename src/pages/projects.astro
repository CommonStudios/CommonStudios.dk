---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import BackLink from '~/components/BackLink.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ImageWindow from '~/components/ImageWindow.astro';
import { projects } from '~/data/projects';
import { CANONICAL } from '~/config/site';
---

<BaseLayout
  title="Tyndfed - Projects"
  description="View Tyndfed's portfolio of innovative projects including Bodegalisten, EXS Nordic, and more."
  canonical={CANONICAL.projects}
  preloadHints={projects.slice(0, 2).map((p) => ({
    href: p.icon,
    as: 'image' as const,
    type: 'image/png',
    fetchPriority: 'high' as const,
  }))}
>
  <WindowChrome>
    <div class="projects-content window-scroll-region">
      <BackLink />
      <section class="projects" data-projects-grid>
        {projects.map((project, index) => (
          <ProjectCard project={project} priority={index < 2} />
        ))}
      </section>
    </div>

    <ImageWindow defaultTitle="EXS Nordic logo" />
  </WindowChrome>

<style>
  .projects {
    padding: 28px 32px 44px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    align-content: start;
    position: relative;
  }

  :global(.projects-spotlight) {
    position: fixed;
    width: 800px;
    height: 800px;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(
        circle,
        rgba(132, 0, 255, 0.15) 0%,
        rgba(132, 0, 255, 0.08) 15%,
        rgba(132, 0, 255, 0.04) 25%,
        rgba(132, 0, 255, 0.02) 40%,
        rgba(132, 0, 255, 0.01) 65%,
        transparent 70%
      );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate(-50%, -50%);
    z-index: 200;
    will-change: transform, opacity;
  }

  :global(.project-particle::before) {
    content: '';
    position: absolute;
    inset: -2px;
    background: rgba(132, 0, 255, 0.2);
    border-radius: 50%;
    z-index: -1;
  }

  @supports (content-visibility: auto) {
    .projects {
      content-visibility: auto;
      contain-intrinsic-size: 980px;
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding: 16px 14px 18px;
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .projects {
      padding: 10px 10px 14px;
      gap: 8px;
    }
  }
</style>

<script>
  import { initCardGlow } from '~/scripts/card-glow';
  initCardGlow('[data-projects-grid]');
</script>
</BaseLayout>