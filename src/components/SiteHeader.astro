---
import { LOCALE_COOKIE, type Locale } from '~/i18n/constants';
import { type PageSegment, pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
  /** Current page; `undefined` on pages without a translated twin (404). */
  segment?: PageSegment;
  cloudSea?: boolean;
}

const { locale, segment, cloudSea = false } = Astro.props;
const t = ui(locale);
const otherLocale: Locale = locale === 'da' ? 'en' : 'da';
const home = pathForLocale(locale, '');
---

<header class="site-header wrap">
  <a href={home} class="wordmark" aria-label={t.nav.home}>CommonStudios</a>

  <nav class="site-nav" aria-label={t.nav.label}>
    <a href={`${home}#work`}>{t.nav.work}</a>
    <a href={`${home}#contact`}>{t.nav.contact}</a>
    {segment !== undefined && (
      <a
        href={pathForLocale(otherLocale, segment)}
        hreflang={otherLocale}
        lang={otherLocale}
        data-locale-choice={otherLocale}
      >
        {t.nav.otherLanguage}
      </a>
    )}
  </nav>

  {cloudSea && (
    <div class="cloud-sea" aria-hidden="true">
      <script is:inline type="module" src="https://ascii.rest/ascii.js"></script>
      <ascii-art src="/ascii/cloud-sea.js"></ascii-art>
    </div>
  )}
</header>

<script is:inline define:vars={{ cookieName: LOCALE_COOKIE }}>
  // Remember an explicit language choice so `/` opens in that language next time.
  document.querySelector('[data-locale-choice]')?.addEventListener('click', (event) => {
    const value = event.currentTarget.dataset.localeChoice;
    document.cookie = `${cookieName}=${value}; path=/; max-age=31536000; samesite=lax; secure`;
  });
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
  }

  .cloud-sea {
    flex-basis: 100%;
    min-width: 0;
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  ascii-art {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    background: var(--oxide);
  }

  .wordmark {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  @media (max-width: 40rem) {
    .wordmark {
      font-size: var(--step-0);
    }
  }

  .site-nav {
    display: flex;
    gap: 0.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .site-nav a {
    /* Pads the tap target to 44px without moving the text. */
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--lichen);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--patina);
  }
</style>
