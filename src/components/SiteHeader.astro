---
import AsciiLogo from '~/components/AsciiLogo.astro';
import { LOCALE_COOKIE, type Locale } from '~/i18n/constants';
import { type PageSegment, pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
  /** Current page; `undefined` on pages without a translated twin (404). */
  segment?: PageSegment;
  asciiBrand?: boolean;
}

const { locale, segment, asciiBrand = false } = Astro.props;
const t = ui(locale);
const otherLocale: Locale = locale === 'da' ? 'en' : 'da';
const home = pathForLocale(locale, '');
---

<header class:list={['site-header', 'wrap', { 'has-ascii': asciiBrand }]}>
  {!asciiBrand && <a href={home} class="wordmark" aria-label={t.nav.home}>CommonStudios</a>}

  <nav class="site-nav" aria-label={t.nav.label}>
    <a href={`${home}#work`}>{t.nav.work}</a>
    <a href={`${home}#contact`}>{t.nav.contact}</a>
    {segment !== undefined && (
      <a
        href={pathForLocale(otherLocale, segment)}
        hreflang={otherLocale}
        lang={otherLocale}
        data-locale-choice={otherLocale}
      >
        {t.nav.otherLanguage}
      </a>
    )}
  </nav>

  {asciiBrand && (
    <a href={home} class="ascii-brand" aria-label={t.nav.home}>
      <AsciiLogo label="CommonStudios" />
    </a>
  )}
</header>

<script is:inline define:vars={{ cookieName: LOCALE_COOKIE }}>
  // Remember an explicit language choice so `/` opens in that language next time.
  document.querySelector('[data-locale-choice]')?.addEventListener('click', (event) => {
    const value = event.currentTarget.dataset.localeChoice;
    document.cookie = `${cookieName}=${value}; path=/; max-age=31536000; samesite=lax; secure`;
  });
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem;
  }

  /* Home: nav on top, the ascii wordmark across the full width below it.
     Block layout, not flex: the wordmark sizes its text from its own width,
     which flexbox measures as zero. */
  .site-header.has-ascii {
    display: block;
  }

  .site-header.has-ascii .site-nav {
    justify-content: flex-end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .ascii-brand {
    text-decoration: none;
  }

  .ascii-brand:hover {
    color: inherit;
  }

  .wordmark {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 0.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .site-nav a {
    /* Pads the tap target to 44px without moving the text. */
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--lichen);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--patina);
  }
</style>
