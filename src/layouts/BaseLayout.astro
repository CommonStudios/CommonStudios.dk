---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import Silk from '~/components/Silk';
import geistLatinUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatinUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import {
  SITE_ORIGIN,
  BRAND_MARK_SRC,
  SEO,
  buildOrganizationJsonLd,
} from '~/config/site';
import { LOCALES, DEFAULT_LOCALE, LOCALE_STORAGE_KEY } from '~/i18n/constants';
import type { Locale } from '~/i18n/constants';
import { canonicalUrl } from '~/i18n/paths';

type LocalePathKey = '' | 'projects' | 'privacy';

type PreloadHint = {
  href: string;
  as: 'image' | 'font' | 'style' | 'script';
  type?: string;
  crossOrigin?: 'anonymous';
  fetchPriority?: 'high' | 'low' | 'auto';
};

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /** BCP 47 language code for `<html lang>`. */
  htmlLang?: string;
  /** Same-origin `<link rel="preload">` hints (merged with brand mark; deduped by `href`). */
  preloadHints?: ReadonlyArray<PreloadHint>;
  /** Hide the global header (e.g. for full-bleed hero pages). */
  hideHeader?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
  /** Lock the page to the viewport (no scroll, full-bleed one-pager). */
  noScroll?: boolean;
  /** Render the animated WebGL silk background. Keep opt-in because it is GPU-heavy. */
  showSilkBackground?: boolean;
  /** Persist locale and emit hreflang when set (locale-prefixed pages). */
  localeContext?: { locale: Locale; pathKey: LocalePathKey };
  /** Translated skip link label (pass from `ui(locale).skipToContent`). */
  skipLinkLabel?: string
}

const {
  title,
  description = SEO.defaultDescription,
  canonical,
  noindex = false,
  ogImage = SEO.defaultOgImage,
  htmlLang = 'en',
  preloadHints = [],
  hideHeader = false,
  hideFooter = false,
  noScroll = false,
  showSilkBackground = false,
  localeContext,
  skipLinkLabel = 'Skip to content',
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_ORIGIN;
const siteBase = `${siteOrigin}/`;
const pageUrl = canonical
  ? new URL(canonical, siteBase).toString()
  : new URL(Astro.url.pathname, siteBase).toString();
const socialImageUrl = new URL(ogImage, siteBase).toString();
const robotsContent = noindex ? 'noindex, follow' : 'index, follow';
const schema = buildOrganizationJsonLd(siteOrigin);

const defaultPreloads: PreloadHint[] = [
  {
    href: BRAND_MARK_SRC,
    as: 'image',
    type: 'image/svg+xml',
    fetchPriority: 'high',
  },
  {
    href: geistLatinUrl,
    as: 'font',
    type: 'font/woff2',
    crossOrigin: 'anonymous',
    fetchPriority: 'high',
  },
  {
    href: geistMonoLatinUrl,
    as: 'font',
    type: 'font/woff2',
    crossOrigin: 'anonymous',
    fetchPriority: 'high',
  },
];
const preloadSeen = new Set<string>();
const mergedPreloads: PreloadHint[] = [];
for (const hint of [...defaultPreloads, ...preloadHints]) {
  if (preloadSeen.has(hint.href)) {
    continue;
  }
  preloadSeen.add(hint.href);
  mergedPreloads.push(hint);
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content={robotsContent} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    {localeContext &&
      LOCALES.map((lng) => (
        <link
          rel="alternate"
          hreflang={lng}
          href={canonicalUrl(siteOrigin, lng, localeContext.pathKey)}
        />
      ))}
    {localeContext && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={canonicalUrl(siteOrigin, DEFAULT_LOCALE, localeContext.pathKey)}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK_SRC} />
    <link rel="apple-touch-icon" href={BRAND_MARK_SRC} />

    {mergedPreloads.map((hint) => (
      <link
        rel="preload"
        href={hint.href}
        as={hint.as}
        {...(hint.type ? { type: hint.type } : {})}
        {...(hint.crossOrigin ? { crossorigin: hint.crossOrigin } : {})}
        {...(hint.fetchPriority ? { fetchpriority: hint.fetchPriority } : {})}
      />
    ))}

    <!--
      Critical CSS — prevents flash, matches global tokens.
      Self-hosted Geist Variable loads via fontsource (imported in global.css).
      The metric-adjusted fallback below covers the brief moment before the
      variable woff2 is parsed, so layout doesn't shift on swap.
    -->
    <style is:inline>
      @font-face {
        font-family: 'Geist Fallback';
        src: local('Arial');
        size-adjust: 105%;
        ascent-override: 92%;
        descent-override: 22%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Geist Mono Fallback';
        src: local('Menlo'), local('Consolas'), local('Courier New');
        size-adjust: 100%;
        ascent-override: 88%;
        descent-override: 22%;
        line-gap-override: 0%;
      }
      html, body {
        background: #0b0c0a;
        margin: 0;
        padding: 0;
      }
      body {
        min-height: 100vh;
        color: #f7f7f2;
        font-family: 'Geist Variable', 'Geist Fallback', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>

    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ ...schema })} />
    {localeContext && (
      <script is:inline define:vars={{ loc: localeContext.locale, key: LOCALE_STORAGE_KEY }}>
        try {
          localStorage.setItem(key, loc);
        } catch (_) {}
      </script>
    )}
  </head>
  <body class:list={[{ 'no-scroll': noScroll }]}>
    <div class="site-background" aria-hidden="true" transition:persist>
      {showSilkBackground && (
        <div class="site-background-silk">
          <Silk
            client:media="(prefers-reduced-motion: no-preference)"
            speed={4}
            scale={1.08}
            color="#2d2923"
            noiseIntensity={1}
            rotation={0}
          />
        </div>
      )}
      <div class="site-background-canvas" />
    </div>

    <a href="#main" class="skip-link">{skipLinkLabel}</a>

    <div class="site-frame">
      <div class="frame-rule frame-rule-top" aria-hidden="true" />
      <div class="frame-rule frame-rule-bottom" aria-hidden="true" />
      <div class="frame-rule frame-rule-left" aria-hidden="true" />
      <div class="frame-rule frame-rule-right" aria-hidden="true" />
      <div class="frame-corner frame-corner-tl" aria-hidden="true" />
      <div class="frame-corner frame-corner-tr" aria-hidden="true" />
      <div class="frame-corner frame-corner-bl" aria-hidden="true" />
      <div class="frame-corner frame-corner-br" aria-hidden="true" />

      <div class="site-frame-content">
        {!hideHeader && (
          <SiteHeader
            locale={localeContext?.locale ?? DEFAULT_LOCALE}
            segment={localeContext?.pathKey ?? ''}
          />
        )}

        <main id="main" class="frame-main">
          <slot />
        </main>

        {!hideFooter && (
          <SiteFooter locale={localeContext?.locale ?? DEFAULT_LOCALE} />
        )}
      </div>
    </div>

    <style is:global>
      html { height: 100%; }
      body {
        min-height: 100dvh;
      }
      body.no-scroll {
        height: 100dvh;
        min-height: 100dvh;
        overflow: hidden;
      }
      body.no-scroll .site-frame {
        height: 100dvh;
        min-height: 100dvh;
        --frame-gap: 24px;
      }
      @media (min-width: 640px) {
        body.no-scroll .site-frame { --frame-gap: 32px; }
      }
      @media (min-width: 1100px) {
        body.no-scroll .site-frame { --frame-gap: 40px; }
      }
      body.no-scroll .site-frame-content {
        min-height: 0;
        height: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--text-ghost) transparent;
      }
      body.no-scroll .frame-main {
        min-height: 0;
        overflow: visible;
        display: flex;
        flex-direction: column;
      }
      body.no-scroll .frame-main > * {
        flex: 1;
        min-height: 0;
      }
      body.no-scroll .frame-main .window-shell {
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }
      body.no-scroll .frame-main .window-shell > * {
        flex: 1;
        min-height: 0;
      }
      .site-frame {
        --frame-pad: 16px;
        --frame-gap: 44px;
        --frame-content-pad: 18px;
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: grid;
        grid-template-columns: var(--frame-pad) 1px minmax(0, 1fr) 1px var(--frame-pad);
        grid-template-rows: var(--frame-pad) 1px minmax(calc(100dvh - (var(--frame-pad) * 2) - 2px), auto) 1px var(--frame-pad);
      }
      .site-frame-content {
        grid-column: 3;
        grid-row: 3;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--frame-gap);
        padding: var(--frame-content-pad);
      }
      .frame-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .frame-rule {
        position: relative;
        background: var(--frame-rule);
      }
      .frame-rule-top {
        grid-column: 1 / -1;
        grid-row: 2;
      }
      .frame-rule-bottom {
        grid-column: 1 / -1;
        grid-row: 4;
      }
      .frame-rule-left {
        grid-column: 2;
        grid-row: 1 / -1;
      }
      .frame-rule-right {
        grid-column: 4;
        grid-row: 1 / -1;
      }
      .frame-corner {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--frame-rule);
        z-index: 2;
      }
      .frame-corner-tl {
        grid-column: 2;
        grid-row: 2;
        place-self: center;
      }
      .frame-corner-tr {
        grid-column: 4;
        grid-row: 2;
        place-self: center;
      }
      .frame-corner-bl {
        grid-column: 2;
        grid-row: 4;
        place-self: center;
      }
      .frame-corner-br {
        grid-column: 4;
        grid-row: 4;
        place-self: center;
      }
      @media (min-width: 640px) {
        .site-frame {
          --frame-pad: 28px;
          --frame-gap: 64px;
          --frame-content-pad: 28px;
        }
      }
      @media (min-width: 1100px) {
        .site-frame {
          --frame-pad: 40px;
          --frame-gap: 88px;
          --frame-content-pad: 40px;
        }
      }
    </style>

    <style>
      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        padding: 8px 14px;
        background: var(--bg-elevated);
        color: var(--text-primary);
        border: 1px solid var(--rule-strong);
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        letter-spacing: 0;
        text-transform: uppercase;
        z-index: 1500;
        transform: translateY(-200%);
        transition: transform var(--duration-fast) ease;
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
