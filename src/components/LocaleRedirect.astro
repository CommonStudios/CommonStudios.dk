---
/**
 * Fallback for the unprefixed root pages (`/`, `/privacy`). In production the
 * worker answers these with a server redirect first (see `worker/index.ts`);
 * this page only runs in `astro dev`/`preview` or if the worker is bypassed.
 */
import { DEFAULT_LOCALE, LOCALE_COOKIE } from '~/i18n/constants';
import type { PageSegment } from '~/i18n/paths';

interface Props {
  segment?: PageSegment;
}

const segment = Astro.props.segment ?? '';
const suffix = segment === '' ? '' : `/${segment}`;
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>CommonStudios</title>
    <link rel="canonical" href={`/${DEFAULT_LOCALE}${suffix}`} />
    <script is:inline define:vars={{ cookieName: LOCALE_COOKIE, suffix }}>
      const saved = document.cookie.match(new RegExp(`(?:^|; )${cookieName}=(da|en)`))?.[1];
      const browser = (navigator.language || '').toLowerCase().startsWith('da') ? 'da' : 'en';
      location.replace(`/${saved ?? browser}${suffix}`);
    </script>
  </head>
  <body style="background:#0d1513;color:#e8ede8;font-family:system-ui,sans-serif;padding:2rem">
    <p><a href={`/da${suffix}`} style="color:inherit">Dansk</a> / <a href={`/en${suffix}`} style="color:inherit" lang="en">English</a></p>
  </body>
</html>
