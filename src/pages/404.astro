---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import { DEFAULT_LOCALE } from '~/i18n/constants';
import { pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

const t = ui(DEFAULT_LOCALE);
---

<BaseLayout
  title={t.notFound.title}
  noindex={true}
  htmlLang={DEFAULT_LOCALE}
  skipLinkLabel={t.skipToContent}
>
  <WindowChrome>
    <section class="not-found shell">
      <p class="eyebrow">
        <span class="meta-num">Err.</span>
        <span class="meta-sep">/</span>
        {t.notFound.eyebrow}
      </p>

      <h1 class="error-headline">
        <span class="line">{t.notFound.headline1}</span>
        <span class="line">{t.notFound.headline2}</span>
      </h1>

      <p class="error-lede">
        {t.notFound.lede}
      </p>

      <div class="error-actions">
        <a href={pathForLocale(DEFAULT_LOCALE, '')} class="cta">
          <span class="cta-label">{t.notFound.ctaHome}</span>
          <span class="cta-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
        <a href={pathForLocale(DEFAULT_LOCALE, 'projects')} class="cta-link">
          {t.notFound.ctaWork}
          <span class="cta-link-rule" aria-hidden="true"></span>
        </a>
      </div>

      <div class="error-glyph" aria-hidden="true">
        <span class="glyph-text">404</span>
      </div>
    </section>
  </WindowChrome>
</BaseLayout>

<style>
  .not-found {
    padding-block: 80px;
    position: relative;
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
  }

  .meta-num { color: var(--accent-secondary); font-weight: 500; }
  .meta-sep { color: var(--text-ghost); }

  .error-headline {
    font-family: var(--font-display);
    font-weight: 540;
    font-variation-settings: normal;
    font-size: var(--font-display-lg);
    line-height: 1;
    letter-spacing: 0;
    margin: 0;
    color: var(--text-primary);
  }

  .error-headline em {
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    color: var(--accent-strong);
  }

  .error-lede {
    margin-top: 32px;
    max-width: 50ch;
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .error-actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 8px 14px 22px;
    background: var(--text-primary);
    color: var(--bg-void);
    border-radius: 14px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    transition: background var(--duration-fast) ease;
  }

  .cta:hover { background: var(--accent-strong); }

  .cta-arrow {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-void);
    color: var(--accent-strong);
    align-items: center;
    justify-content: center;
    transition: transform 320ms var(--ease-out-expo);
  }

  .cta-arrow svg { width: 14px; height: 14px; }

  .cta:hover .cta-arrow { transform: translateX(-3px); }

  .cta-link {
    position: relative;
    font-size: 15px;
    color: var(--text-primary);
    padding-block: 6px;
  }

  .cta-link-rule {
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 1px;
    background: var(--text-primary);
  }

  .cta-link:hover { color: var(--accent-strong); }
  .cta-link:hover .cta-link-rule { background: var(--accent-strong); }

  /* Decorative giant 404 glyph behind the content */
  .error-glyph {
    position: absolute;
    inset: auto 0 -10% auto;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
    z-index: -1;
  }

  .glyph-text {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: normal;
    font-weight: 650;
    font-size: 260px;
    line-height: 0.8;
    letter-spacing: 0;
    background: linear-gradient(
      180deg,
      rgba(212, 184, 122, 0.18),
      rgba(212, 184, 122, 0.04) 60%,
      transparent
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-align: right;
    padding-right: 4vw;
  }

  @media (max-width: 600px) {
    .not-found {
      padding-block: 56px;
    }

    .error-lede {
      font-size: 17px;
    }

    .glyph-text {
      font-size: 150px;
    }

    .error-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cta {
      justify-content: space-between;
      padding: 12px 8px 12px 18px;
    }
  }
</style>
