---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE_ORIGIN, SEO } from '~/config/site';
import { LOCALES, isLocale } from '~/i18n/constants';
import { canonicalUrl, pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) {
  return Astro.redirect('/da');
}
const locale = raw;
const t = ui(locale);
const heroTypingLines = JSON.stringify(t.home.heroTypingLines);
---

<BaseLayout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  canonical={canonicalUrl(SITE_ORIGIN, locale, '')}
  hideFooter
  noScroll
  htmlLang={locale}
  localeContext={{ locale, pathKey: '' }}
  skipLinkLabel={t.skipToContent}
>
  <div class="window-shell page-boot" id="main-window">
    <section class="hero shell" aria-label={t.home.heroAria} data-locale={locale}>
      <div class="hero-center">
        <h1
          class="hero-title"
          aria-label={t.home.heroTitle}
          data-reveal
        >
          <span class="hero-title-line">{t.home.heroTitle}</span>
          <span class="hero-title-cursor" aria-hidden="true">|</span>
        </h1>

        <p class="hero-lede" data-reveal>
          {t.home.heroLede}
        </p>

        <nav class="hero-actions" aria-label={t.home.heroActionsAria} data-reveal>
          <a href={pathForLocale(locale, 'projects')} class="hero-link">
            <span>{t.home.heroCta}</span>
            <svg
              class="hero-link-arrow"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 7h10m0 0L7.5 2.5M12 7l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </nav>
      </div>

      <p class="hero-credit" data-reveal>
        {t.home.heroCreditLead}<span class="hero-credit-name">{SEO.author}</span>{t.home.heroCreditTail}
      </p>
    </section>
  </div>

  <script is:inline data-astro-rerun define:vars={{ lines: heroTypingLines }}>
    (() => {
      const lineEl = document.querySelector('.hero-title-line');
      if (!(lineEl instanceof HTMLElement)) {
        return;
      }

      const phrases = JSON.parse(lines);
      if (!Array.isArray(phrases) || phrases.length < 2) {
        return;
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        lineEl.textContent = phrases[0];
        return;
      }

      let phraseIndex = 0;
      let charIndex = phrases[0].length;
      let deleting = false;
      let timeoutId = 0;

      const tick = () => {
        const phrase = phrases[phraseIndex];
        lineEl.textContent = phrase.slice(0, charIndex);

        if (!deleting && charIndex === phrase.length) {
          deleting = true;
          timeoutId = window.setTimeout(tick, 1800);
          return;
        }

        if (deleting && charIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          timeoutId = window.setTimeout(tick, 220);
          return;
        }

        charIndex += deleting ? -1 : 1;
        timeoutId = window.setTimeout(tick, deleting ? 32 : 54);
      };

      timeoutId = window.setTimeout(tick, 900);

      document.addEventListener('visibilitychange', () => {
        window.clearTimeout(timeoutId);
        if (!document.hidden) {
          timeoutId = window.setTimeout(tick, 160);
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .window-shell {
    position: relative;
    width: 100%;
  }

  .hero {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: start;
    gap: 24px;
    text-align: left;
  }

  .hero-center {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    align-items: flex-start;
    max-width: min(44rem, 100%);
    padding-left: 0;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 520;
    color: var(--text-primary);
    width: 100%;
    max-width: 100%;
    text-wrap: wrap;
    overflow-wrap: normal;
    word-break: normal;
    /* No text-wrap: balance or hyphens — they reflow each keystroke and look jumpy */
    hyphens: none;
    -webkit-hyphens: none;
    /* Fallback before the island measures all hero lines */
    min-height: 2.75lh;
  }

  .hero-title-line {
    display: inline;
  }

  .hero-title-cursor {
    color: var(--accent);
    display: inline-block;
    margin-left: 0.125rem;
    animation: heroCursorBlink 1s var(--ease-smooth) infinite;
  }

  @keyframes heroCursorBlink {
    0%, 45% {
      opacity: 1;
    }

    55%, 100% {
      opacity: 0;
    }
  }

  .hero[data-locale='da'] .hero-title {
    line-height: 1.14;
    min-height: 2.75lh;
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 100%;
      gap: 18px;
    }

    .hero-center {
      justify-content: center;
      gap: 1rem;
    }

    .hero-title {
      font-size: clamp(2rem, 12vw, 2.65rem);
      line-height: 1.08;
      min-height: 3lh;
      overflow-wrap: anywhere;
    }

    .hero[data-locale='da'] .hero-title {
      min-height: 3lh;
    }

    .hero-lede {
      font-size: 1rem;
      line-height: 1.55;
    }

    .hero-credit {
      font-size: 11px;
      line-height: 1.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title-cursor {
      animation: none;
    }
  }

  .hero-lede {
    max-width: 42rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
    font-weight: 400;
  }

  .hero[data-locale='da'] .hero-lede {
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-primary);
    padding: 9px 13px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: rgba(247, 247, 242, 0.035);
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .hero-link-arrow {
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .hero-link:hover {
    color: var(--bg-void);
    background: var(--accent);
    border-color: var(--accent);
  }

  .hero-link:hover .hero-link-arrow {
    transform: translateX(3px);
  }

  .hero-credit {
    align-self: end;
    padding-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: none;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    line-height: 1.5;
    max-width: 36rem;
  }

  .hero-credit-name {
    color: var(--text-secondary);
  }

  @media (max-width: 700px) {
    .hero {
      gap: 22px;
    }

    .hero-center {
      gap: 1.25rem;
      max-width: min(100%, 20rem);
    }

    .hero-title {
      font-size: clamp(2rem, 10vw, 2.45rem);
      overflow-wrap: anywhere;
    }

    .hero-credit {
      padding-top: 16px;
      max-width: min(100%, 20rem);
    }
  }
</style>
