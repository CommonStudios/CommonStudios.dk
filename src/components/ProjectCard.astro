---
import type { Project } from '~/data/projects';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
---

<article class="project" data-card-glow data-magic-card>
  <header class="project-header">
    <img
      src={project.icon}
      alt={`${project.name} logo`}
      class="project-icon"
      data-card-icon
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="64"
      height="64"
    />
    <h3 class="project-title">{project.name}</h3>
  </header>
  <p class="project-description">{project.description}</p>
  <div class="project-links">
    {project.links.map((link) => {
      const isExsLogoPreview =
        project.name === 'EXS Nordic' && (link.label === 'Logo (hvid)' || link.label === 'Logo (sort)');

      return isExsLogoPreview ? (
        <button
          type="button"
          class="project-link project-link-button"
          data-image-window-trigger
          data-image-window-title={`${project.name} - ${link.label}`}
          data-image-window-src={link.url}
          aria-label={`${project.name} - ${link.label} (opens logo preview window)`}
        >
          → {link.label}
        </button>
      ) : (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.name} - ${link.label} (opens in a new tab)`}
          class="project-link"
        >
          → {link.label}
        </a>
      );
    })}
  </div>
</article>

<style>
  .project {
    --glow-x: 50%;
    --glow-y: 50%;
    --glow-intensity: 0;
    --glow-radius: 300px;
    --project-glow-rgb: 132, 0, 255;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    min-height: 228px;
    width: 100%;
    padding: 1.25em;
    border-radius: 20px;
    border: 1px solid #392e4e;
    background: #060010;
    font-weight: 300;
    overflow: hidden;
    isolation: isolate;
    gap: 14px;
    will-change: transform;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @supports (content-visibility: auto) {
    .project {
      content-visibility: auto;
      contain-intrinsic-size: 260px;
    }
  }

  .project::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    padding: 6px;
    background: radial-gradient(
      var(--glow-radius) circle at var(--glow-x) var(--glow-y),
      rgba(var(--project-glow-rgb), calc(var(--glow-intensity) * 0.8)) 0%,
      rgba(var(--project-glow-rgb), calc(var(--glow-intensity) * 0.4)) 30%,
      transparent 78%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    z-index: 0;
  }

  .project > * {
    position: relative;
    z-index: 1;
  }

  .project:hover {
    box-shadow:
      0 8px 25px rgba(0, 0, 0, 0.15),
      0 4px 20px rgba(46, 24, 78, 0.4),
      0 0 30px rgba(132, 0, 255, 0.2);
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .project-icon {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .project-title {
    color: #fff;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
  }

  .project-description {
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .project-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.74rem;
    font-weight: 500;
    padding: 7px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-normal) var(--ease-smooth);
  }

  .project-link:hover {
    color: #fff;
    border-color: rgba(132, 0, 255, 0.55);
    background: rgba(132, 0, 255, 0.12);
    box-shadow: 0 0 24px rgba(132, 0, 255, 0.18);
    transform: translateY(-1px);
  }

  .project-link:active {
    transform: translateY(0);
    border-color: var(--interactive-border-active);
  }

  .project-link:focus-visible {
    border-color: var(--interactive-border-active);
    box-shadow: var(--interactive-shadow-strong);
  }

  .project-link-button {
    font-family: inherit;
    line-height: 1.2;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .project {
      padding: 14px;
      gap: 11px;
      min-height: 200px;
    }

    .project-header {
      gap: 10px;
    }

    .project-icon {
      width: 48px;
      height: 48px;
    }

    .project-title {
      font-size: var(--font-size-base);
    }

    .project-description {
      font-size: var(--font-size-xs);
      line-height: 1.55;
    }

    .project-links {
      gap: 7px;
      margin-top: 2px;
    }

    .project-link {
      font-size: 11px;
      padding: 5px 8px;
      min-height: 30px;
    }
  }

  @media (max-width: 480px) {
    .project {
      padding: 12px;
      gap: 10px;
    }

    .project-header {
      gap: 9px;
    }

    .project-icon {
      width: 42px;
      height: 42px;
    }

    .project-title {
      font-size: var(--font-size-sm);
    }

    .project-description {
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .project-links {
      gap: 6px;
      margin-top: 0;
    }

    .project-link {
      width: auto;
      text-align: left;
      min-height: 28px;
      padding: 4px 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project {
      transition: box-shadow 0.2s ease;
    }
  }
</style>
