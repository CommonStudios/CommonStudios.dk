---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '~/i18n/constants';
import { pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

// Served for every missing URL regardless of language, so it speaks both.
const da = ui('da');
const en = ui('en');
---

<BaseLayout title={da.notFound.title} locale={DEFAULT_LOCALE} noindex>
  <div class="not-found wrap">
    <h1>{da.notFound.heading}</h1>
    <p>
      {da.notFound.text}
      <a href={pathForLocale('da', '')}>{da.notFound.home}</a>
    </p>
    <p lang="en">
      {en.notFound.text}
      <a href={pathForLocale('en', '')}>{en.notFound.home}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  h1 {
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin-bottom: 2rem;
  }

  p {
    max-width: var(--measure);
    color: var(--lichen);
  }

  p + p {
    margin-top: 0.75rem;
  }

  a {
    color: var(--paper);
  }
</style>
