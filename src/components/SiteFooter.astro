---
import { CONTACT, SOCIAL_URLS } from '~/config/site';
import type { Locale } from '~/i18n/constants';
import { pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

interface Props {
  locale: Locale;
  cloudSea?: boolean;
}

const { locale, cloudSea = false } = Astro.props;
const t = ui(locale);
const social = [
  { name: 'LinkedIn', url: SOCIAL_URLS.linkedin },
  { name: 'GitHub', url: SOCIAL_URLS.github },
  { name: 'Instagram', url: SOCIAL_URLS.instagram },
];
---

<footer class="site-footer wrap">
  <p>
    CommonStudios, {t.footer.location}<br />
    CVR {CONTACT.registrationNumber}
  </p>
  <nav aria-label={t.footer.social}>
    {social.map((link) => (
      <a href={link.url} rel="me noopener" target="_blank">{link.name}</a>
    ))}
  </nav>
  <a href={pathForLocale(locale, 'privacy')}>{t.footer.privacy}</a>
  {cloudSea && (
    <div class="cloud-sea" aria-hidden="true">
      <script is:inline type="module" src="https://ascii.rest/ascii.js"></script>
      <ascii-art src="/ascii/cloud-sea.js"></ascii-art>
    </div>
  )}
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 3rem;
    padding-block: 5rem 2.5rem;
    color: var(--lichen);
    font-size: var(--step--1);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  a {
    display: inline-block;
    /* Lifts the tap target above 24px without changing how the row reads. */
    padding-block: 0.25rem;
    text-decoration: none;
  }

  .cloud-sea {
    flex-basis: 100%;
    min-width: 0;
    margin-top: 1.75rem;
  }

  ascii-art {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    background: var(--oxide);
  }
</style>
