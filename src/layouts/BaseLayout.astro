---
import '~/styles/global.css';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import {
  SITE_ORIGIN,
  BRAND_MARK_SRC,
  SEO,
  FONT_PRECONNECT,
  FONT_STYLESHEETS,
  buildOrganizationJsonLd,
} from '~/config/site';

type PreloadHint = {
  href: string;
  as: 'image' | 'font' | 'style' | 'script';
  type?: string;
  crossOrigin?: 'anonymous';
  fetchPriority?: 'high' | 'low' | 'auto';
};

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /** BCP 47 language code for `<html lang>`. */
  htmlLang?: string;
  /** Same-origin `<link rel="preload">` hints (merged with brand mark; deduped by `href`). */
  preloadHints?: ReadonlyArray<PreloadHint>;
  /** Hide the global header (e.g. for full-bleed hero pages). */
  hideHeader?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
}

const {
  title,
  description = SEO.defaultDescription,
  canonical,
  noindex = false,
  ogImage = SEO.defaultOgImage,
  htmlLang = 'en',
  preloadHints = [],
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_ORIGIN;
const siteBase = `${siteOrigin}/`;
const pageUrl = canonical
  ? new URL(canonical, siteBase).toString()
  : new URL(Astro.url.pathname, siteBase).toString();
const socialImageUrl = new URL(ogImage, siteBase).toString();
const robotsContent = noindex ? 'noindex, follow' : 'index, follow';
const schema = buildOrganizationJsonLd(siteOrigin);

const defaultPreloads: PreloadHint[] = [
  {
    href: BRAND_MARK_SRC,
    as: 'image',
    type: 'image/svg+xml',
    fetchPriority: 'high',
  },
];
const preloadSeen = new Set<string>();
const mergedPreloads: PreloadHint[] = [];
for (const hint of [...defaultPreloads, ...preloadHints]) {
  if (preloadSeen.has(hint.href)) {
    continue;
  }
  preloadSeen.add(hint.href);
  mergedPreloads.push(hint);
}
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content={robotsContent} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK_SRC} />
    <link rel="apple-touch-icon" href={BRAND_MARK_SRC} />

    {mergedPreloads.map((hint) => (
      <link
        rel="preload"
        href={hint.href}
        as={hint.as}
        {...(hint.type ? { type: hint.type } : {})}
        {...(hint.crossOrigin ? { crossorigin: hint.crossOrigin } : {})}
        {...(hint.fetchPriority ? { fetchpriority: hint.fetchPriority } : {})}
      />
    ))}

    {FONT_PRECONNECT.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin />
    ))}
    <link rel="preload" as="style" href={FONT_STYLESHEETS.primary} />
    <link rel="stylesheet" href={FONT_STYLESHEETS.primary} />

    <!-- Critical CSS — prevents flash, matches global tokens -->
    <style is:inline>
      html, body {
        background: #0b0c0a;
        margin: 0;
        padding: 0;
      }
      body {
        min-height: 100vh;
        color: #f7f7f2;
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>

    <script is:inline type="application/ld+json" set:html={JSON.stringify({ ...schema })} />
  </head>
  <body>
    <div class="site-background" aria-hidden="true" transition:persist>
      <div class="site-background-canvas" />
    </div>

    <a href="#main" class="skip-link">Skip to content</a>

    <div class="site-frame">
      <div class="frame-rule frame-rule-top" aria-hidden="true" />
      <div class="frame-rule frame-rule-bottom" aria-hidden="true" />
      <div class="frame-rule frame-rule-left" aria-hidden="true" />
      <div class="frame-rule frame-rule-right" aria-hidden="true" />
      <div class="frame-corner frame-corner-tl" aria-hidden="true" />
      <div class="frame-corner frame-corner-tr" aria-hidden="true" />
      <div class="frame-corner frame-corner-bl" aria-hidden="true" />
      <div class="frame-corner frame-corner-br" aria-hidden="true" />

      <div class="site-frame-content">
        {!hideHeader && <SiteHeader />}

        <main id="main" class="frame-main">
          <slot />
        </main>

        {!hideFooter && <SiteFooter />}
      </div>
    </div>

    <style is:global>
      html { height: 100%; }
      body {
        min-height: 100dvh;
      }
      .site-frame {
        --frame-pad: 16px;
        --frame-gap: 44px;
        --frame-content-pad: 18px;
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: grid;
        grid-template-columns: var(--frame-pad) 1px minmax(0, 1fr) 1px var(--frame-pad);
        grid-template-rows: var(--frame-pad) 1px minmax(calc(100dvh - (var(--frame-pad) * 2) - 2px), auto) 1px var(--frame-pad);
      }
      .site-frame-content {
        grid-column: 3;
        grid-row: 3;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--frame-gap);
        padding: var(--frame-content-pad);
      }
      .frame-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .frame-rule {
        position: relative;
        background: var(--frame-rule);
      }
      .frame-rule::before {
        content: '';
        position: absolute;
        background: var(--frame-rule-soft);
      }
      .frame-rule-top {
        grid-column: 1 / -1;
        grid-row: 2;
      }
      .frame-rule-top::before,
      .frame-rule-bottom::before {
        inset: -8px 0;
      }
      .frame-rule-bottom {
        grid-column: 1 / -1;
        grid-row: 4;
      }
      .frame-rule-left {
        grid-column: 2;
        grid-row: 1 / -1;
      }
      .frame-rule-right {
        grid-column: 4;
        grid-row: 1 / -1;
      }
      .frame-rule-left::before,
      .frame-rule-right::before {
        inset: 0 -8px;
      }
      .frame-corner {
        width: 7px;
        height: 7px;
        border: 1px solid var(--frame-rule);
        background: var(--bg-void);
        z-index: 2;
      }
      .frame-corner-tl {
        grid-column: 1;
        grid-row: 1;
        align-self: end;
        justify-self: end;
        transform: translate(4px, 4px);
      }
      .frame-corner-tr {
        grid-column: 5;
        grid-row: 1;
        align-self: end;
        justify-self: start;
        transform: translate(-4px, 4px);
      }
      .frame-corner-bl {
        grid-column: 1;
        grid-row: 5;
        align-self: start;
        justify-self: end;
        transform: translate(4px, -4px);
      }
      .frame-corner-br {
        grid-column: 5;
        grid-row: 5;
        align-self: start;
        justify-self: start;
        transform: translate(-4px, -4px);
      }
      @media (min-width: 640px) {
        .site-frame {
          --frame-pad: 28px;
          --frame-gap: 64px;
          --frame-content-pad: 28px;
        }
      }
      @media (min-width: 1100px) {
        .site-frame {
          --frame-pad: 40px;
          --frame-gap: 88px;
          --frame-content-pad: 40px;
        }
      }
    </style>

    <style>
      .skip-link {
        position: fixed;
        top: 8px;
        left: 8px;
        padding: 8px 14px;
        background: var(--bg-elevated);
        color: var(--text-primary);
        border: 1px solid var(--rule-strong);
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        letter-spacing: 0;
        text-transform: uppercase;
        z-index: 1500;
        transform: translateY(-200%);
        transition: transform var(--duration-fast) ease;
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
