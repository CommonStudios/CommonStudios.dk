---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import ImageWindow from '~/components/ImageWindow.astro';
import { projects } from '~/data/projects';
import { SITE_ORIGIN } from '~/config/site';
import { isLogoPreviewLink } from '~/constants/project-ui';
import { LOCALES, isLocale } from '~/i18n/constants';
import { canonicalUrl } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

const getImageType = (src: string) => (src.endsWith('.svg') ? 'image/svg+xml' : 'image/png');

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) {
  return Astro.redirect('/da/projects');
}
const locale = raw;
const t = ui(locale);
---

<BaseLayout
  title={t.meta.projectsTitle}
  description={t.meta.projectsDescription}
  canonical={canonicalUrl(SITE_ORIGIN, locale, 'projects')}
  htmlLang={locale}
  localeContext={{ locale, pathKey: 'projects' }}
  skipLinkLabel={t.skipToContent}
  preloadHints={projects.slice(0, 2).map((p) => ({
    href: p.icon,
    as: 'image' as const,
    type: getImageType(p.icon),
    fetchPriority: 'high' as const,
  }))}
>
  <WindowChrome>
    <section
      class="projects-hero shell"
      aria-label={t.projects.introAria}
      data-locale={locale}
      data-reveal
      data-reveal-delay="0"
    >
      <div class="projects-hero-inner">
        <p class="projects-eyebrow">{t.projects.eyebrow}</p>
        <h1>{t.projects.title}</h1>
        <p class="projects-lede">
          {t.projects.lede}
        </p>
      </div>
    </section>

    <section class="projects-list shell" aria-label={t.projects.listAria} data-locale={locale}>
      {projects.map((project, index) => {
        const tags = project.links.map((link) => link.label[locale]).join(' · ');
        return (
          <article class="project-row" data-reveal data-reveal-delay={String(index * 60)}>
            <div class="project-aside">
              <img
                src={project.icon}
                alt=""
                class="project-icon"
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
                width="56"
                height="56"
              />
            </div>

            <div class="project-main">
              <div class="project-meta">
                <span>{tags}</span>
              </div>
              <h2 class="project-name">{project.name}</h2>
              <p class="project-desc">{project.description[locale]}</p>
              <nav class="project-links" aria-label={`${project.name} ${t.projects.linksNavSuffix}`}>
                {project.links.map((link) => {
                  const label = link.label[locale];
                  return isLogoPreviewLink(project.name, link.label) ? (
                    <a
                      href={link.url}
                      class="project-link"
                      data-image-window-trigger
                      data-image-window-title={`${project.name} - ${label}`}
                      data-image-window-src={link.url}
                      download
                    >
                      {label}
                    </a>
                  ) : (
                    <a
                      class="project-link"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {label}
                    </a>
                  );
                })}
              </nav>
            </div>
          </article>
        );
      })}
    </section>

    <ImageWindow defaultTitle={t.projects.imageWindowTitle} closeLabel={t.common.closeImagePreview} />
  </WindowChrome>
</BaseLayout>

<style>
  .projects-hero {
    padding-top: 12px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--rule);
    /* Same measure for all locales — avoids layout jump on language switch */
    max-width: min(44rem, 100%);
  }

  .projects-hero-inner {
    padding-left: 0;
    display: grid;
    gap: 1.25rem;
  }

  .projects-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-transform: none;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .projects-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 520;
    color: var(--text-primary);
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    -webkit-hyphens: none;
    margin: 0;
  }

  .projects-hero[data-locale='da'] h1 {
    line-height: 1.14;
  }

  .projects-lede {
    margin: 0;
    max-width: 42rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
    font-weight: 400;
  }

  .projects-hero[data-locale='da'] .projects-lede {
    line-height: 1.72;
  }

  .projects-list {
    padding-top: 8px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    max-width: min(44rem, 100%);
  }


  .project-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 32px 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-row:last-child {
    border-bottom: none;
  }

  .project-aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    padding-top: 10px;
  }

  .project-meta {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.45;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .project-icon {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-elevated);
    object-fit: cover;
    display: block;
    border: none;
    filter: grayscale(0.86) saturate(0.38) contrast(1.12) brightness(0.96);
    transition: none;
  }

  [data-reveal] {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 560ms var(--ease-out-expo),
      transform 560ms var(--ease-out-expo),
      filter 560ms var(--ease-out-expo);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform, filter;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .project-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 2px;
  }


  .project-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 520;
    margin: 0;
    color: var(--text-primary);
  }

  .project-desc {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: 1.65;
    margin: 10px 0 0;
    max-width: 100%;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .project-link {
    appearance: none;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    cursor: pointer;
    padding: 8px 14px;
    margin: 0;
    width: fit-content;
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .project-link:hover {
    color: var(--bg-void);
    background: var(--accent);
    border-color: var(--accent);
  }

  .project-link:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .project-row {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    .projects-hero h1 {
      font-size: clamp(2rem, 11vw, 2.65rem);
      line-height: 1.08;
      text-wrap: wrap;
    }

    .projects-lede,
    .project-desc {
      font-size: 1rem;
      line-height: 1.58;
    }

    .projects-hero-inner {
      gap: 1rem;
    }

    .projects-hero {
      padding-bottom: 32px;
    }

    .project-row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
      padding: 24px 0;
    }

    .project-aside {
      gap: 10px;
      padding-top: 8px;
    }

    .project-icon {
      width: 44px;
      height: 44px;
    }

    .project-meta {
      margin-bottom: 6px;
    }

    .project-links {
      gap: 12px 18px;
      margin-top: 14px;
    }

    .project-link {
      min-height: 40px;
      padding: 10px 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced || revealItems.length === 0) {
    revealItems.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target;
          if (!(el instanceof HTMLElement)) continue;
          const delayValue = Number(el.dataset.revealDelay ?? '0');
          const delayMs = Number.isFinite(delayValue) ? Math.max(0, delayValue) : 0;
          el.style.setProperty('--reveal-delay', `${delayMs}ms`);
          el.classList.add('is-visible');
          observer.unobserve(el);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((el) => observer.observe(el));
  }
</script>
