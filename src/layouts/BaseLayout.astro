---
import { SpeedInsights } from '@vercel/speed-insights/react';
import { ClientRouter } from 'astro:transitions';
import '~/styles/global.css';
import ColorBends from '~/components/ColorBends';
import {
  SITE_ORIGIN,
  BRAND_MARK_SRC,
  SEO,
  FONT_PRECONNECT,
  FONT_STYLESHEETS,
  buildOrganizationJsonLd,
} from '~/config/site';

type PreloadHint = {
  href: string;
  as: 'image' | 'font' | 'style' | 'script';
  type?: string;
  crossOrigin?: 'anonymous';
  fetchPriority?: 'high' | 'low' | 'auto';
};

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /** BCP 47 language code for `<html lang>`. */
  htmlLang?: string;
  /** Same-origin `<link rel="preload">` hints (merged with brand mark; deduped by `href`). */
  preloadHints?: ReadonlyArray<PreloadHint>;
}

const {
  title,
  description = SEO.defaultDescription,
  canonical,
  noindex = false,
  ogImage = SEO.defaultOgImage,
  htmlLang = 'en',
  preloadHints = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_ORIGIN;
const siteBase = `${siteOrigin}/`;
const pageUrl = canonical
  ? new URL(canonical, siteBase).toString()
  : new URL(Astro.url.pathname, siteBase).toString();
const socialImageUrl = new URL(ogImage, siteBase).toString();
const robotsContent = noindex ? 'noindex, follow' : 'index, follow';
const isProd = import.meta.env.PROD;

const schema = buildOrganizationJsonLd(siteOrigin);

const defaultPreloads: PreloadHint[] = [
  {
    href: BRAND_MARK_SRC,
    as: 'image',
    type: 'image/svg+xml',
    fetchPriority: 'high',
  },
];
const preloadSeen = new Set<string>();
const mergedPreloads: PreloadHint[] = [];
for (const hint of [...defaultPreloads, ...preloadHints]) {
  if (preloadSeen.has(hint.href)) {
    continue;
  }
  preloadSeen.add(hint.href);
  mergedPreloads.push(hint);
}

const satoshiStylesheetUrl = FONT_STYLESHEETS.satoshi;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content={SEO.author} />
    <meta name="robots" content={robotsContent} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK_SRC} />
    <link rel="apple-touch-icon" href={BRAND_MARK_SRC} />

    {mergedPreloads.map((hint) => (
      <link
        rel="preload"
        href={hint.href}
        as={hint.as}
        {...(hint.type ? { type: hint.type } : {})}
        {...(hint.crossOrigin ? { crossorigin: hint.crossOrigin } : {})}
        {...(hint.fetchPriority ? { fetchpriority: hint.fetchPriority } : {})}
      />
    ))}

    <!-- Warm connections before first font/CSS request. -->
    {FONT_PRECONNECT.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin />
    ))}
    <link rel="dns-prefetch" href="https://vitals.vercel-insights.com" />

    <!-- Mono CSS first (critical inline stack); Satoshi is non-blocking to shorten render path. -->
    <link rel="preload" as="style" href={FONT_STYLESHEETS.mono} />
    <link rel="stylesheet" href={FONT_STYLESHEETS.mono} />
    <link rel="preload" as="style" href={FONT_STYLESHEETS.satoshi} />
    <script is:inline define:vars={{ satoshiStylesheetUrl }}>
      (function injectNonBlockingStylesheet(href) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        link.media = 'print';
        link.onload = function () {
          link.media = 'all';
        };
        document.head.appendChild(link);
      })(satoshiStylesheetUrl);
    </script>
    <noscript>
      <link rel="stylesheet" href={FONT_STYLESHEETS.satoshi} />
    </noscript>

    <!-- Critical CSS to prevent layout shift -->
    <style is:inline>
      html, body {
        background: #0c0c0f;
        margin: 0;
        padding: 0;
      }
      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 32px;
        color: #f0f0f2;
        font-family: 'JetBrains Mono', 'SF Mono', monospace;
      }
      @media (max-width: 768px) {
        body { padding: 16px; }
      }
      @media (max-width: 480px) {
        body {
          padding: 10px;
          align-items: flex-start;
        }
      }
    </style>

    <script is:inline type="application/ld+json" set:html={JSON.stringify({ ...schema })} />
    <ClientRouter />
  </head>
  <body>
    <div class="site-background" aria-hidden="true" transition:persist>
      <ColorBends
        client:media="(min-width: 900px)"
        className="site-background-canvas"
        colors={["#ff5c7a", "#8a5cff", "#00ffd1"]}
        rotation={0}
        speed={0.2}
        scale={1}
        frequency={1}
        warpStrength={1}
        mouseInfluence={1}
        parallax={0.5}
        noise={0.1}
        transparent
        autoRotate={0}
        color=""
      />
    </div>
    <div class="site-content">
      <slot />
    </div>
    {isProd && <SpeedInsights client:idle />}
  </body>
</html>
