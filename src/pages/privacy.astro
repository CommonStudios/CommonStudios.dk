---
const STORAGE = 'tyndfed-lang';
const suffix = '/privacy';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Tyndfed — Privacy</title>
    <link rel="icon" type="image/svg+xml" href="/images/tyndfed.svg" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0b0c0a;
        color: #b9bcb1;
        font-family: 'Geist', system-ui, sans-serif;
        font-size: 15px;
        padding: 24px;
      }
      p {
        margin: 0;
        text-align: center;
      }
      a {
        color: #f7f7f2;
        text-decoration: none;
        border-bottom: 1px solid rgba(247, 247, 242, 0.25);
      }
      a:hover {
        color: #e8d49b;
        border-color: #d4b87a;
      }
    </style>
  </head>
  <body>
    <p>
      <a href="/da/privacy">Dansk</a>
      <span aria-hidden="true"> · </span>
      <a href="/en/privacy">English</a>
    </p>
    <script is:inline define:vars={{ STORAGE, suffix }}>
      (function () {
        function pick() {
          try {
            var s = localStorage.getItem(STORAGE);
            if (s === 'da' || s === 'en') return s;
          } catch (_) {}
          var nav = navigator.language || '';
          return nav.toLowerCase().startsWith('da') ? 'da' : 'en';
        }
        location.replace('/' + pick() + suffix);
      })();
    </script>
  </body>
</html>
