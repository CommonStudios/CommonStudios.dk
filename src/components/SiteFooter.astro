---
import { socialLinks } from '~/data/social';
import type { Locale } from '~/i18n/constants';
import { DEFAULT_LOCALE } from '~/i18n/constants';
import { pathForLocale } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const t = ui(locale);
---

<footer class="footer-grid">
  <div class="shell">
    <div class="grid-body">
      <div class="grid-col">
        <p class="grid-label">{t.footer.contact}</p>
        <a class="grid-email" href="mailto:kontakt@tyndfed.dk">
          kontakt@tyndfed.dk
        </a>
        <p class="grid-detail">{t.footer.copenhagen}</p>
        <p class="grid-detail">CVR 39125307</p>
      </div>

      <div class="grid-col">
        <p class="grid-label">{t.footer.navigation}</p>
        <nav aria-label={t.footer.footerNav}>
          <a class="grid-link" href={pathForLocale(locale, 'projects')}>{t.footer.projects}</a>
          <a class="grid-link" href={pathForLocale(locale, 'privacy')}>{t.footer.privacy}</a>
        </nav>
      </div>

      <div class="grid-col">
        <p class="grid-label">{t.footer.social}</p>
        <nav class="grid-social" aria-label={t.footer.socialMedia}>
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="grid-social-link"
              aria-label={link.name}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                <path d={link.icon} />
              </svg>
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-grid {
    border-top: 1px solid var(--rule);
    padding-top: 24px;
  }

  .grid-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    padding-block: 28px;
  }

  @media (min-width: 768px) {
    .grid-body {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .grid-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .grid-email {
    display: block;
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 560;
    letter-spacing: 0;
    color: var(--text-primary);
    margin-bottom: 8px;
    transition: color var(--duration-fast) ease;
  }

  .grid-email:hover {
    color: var(--accent-strong);
  }

  .grid-detail {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .grid-link {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 8px;
    width: fit-content;
    transition: color var(--duration-fast) ease, background var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .grid-link:hover {
    color: var(--bg-void);
    background: var(--accent);
    border-color: var(--accent);
  }

  .grid-social {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .grid-social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    padding: 8px 14px;
    width: fit-content;
    transition: color var(--duration-fast) ease, background var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .grid-social-link:hover {
    color: var(--bg-void);
    background: var(--accent);
    border-color: var(--accent);
  }

</style>
