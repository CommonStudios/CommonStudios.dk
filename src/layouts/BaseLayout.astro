---
import '~/styles/global.css';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import fontUrl from '~/assets/fonts/NordwandMono-Regular.woff2?url';
import {
  APPLE_TOUCH_ICON_SRC,
  FAVICON_SRC,
  SEO,
  SITE_ORIGIN,
  buildJsonLd,
} from '~/config/site';
import {
  DEFAULT_LOCALE,
  LOCALES,
  OG_LOCALE,
  type Locale,
} from '~/i18n/constants';
import { canonicalUrl, type PageSegment } from '~/i18n/paths';
import { ui } from '~/i18n/ui';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Set on locale-prefixed pages: emits canonical + hreflang and remembers the language. */
  segment?: PageSegment;
  noindex?: boolean;
  ogImage?: string;
  /** Show the animated ascii wordmark in the header (home page). */
  asciiBrand?: boolean;
}

const {
  title,
  description = SEO.defaultDescription,
  locale = DEFAULT_LOCALE,
  segment,
  noindex = false,
  ogImage = SEO.defaultOgImage,
  asciiBrand = false,
} = Astro.props;

const origin = (Astro.site?.toString() ?? SITE_ORIGIN).replace(/\/$/, '');
const pageUrl =
  segment === undefined
    ? new URL(Astro.url.pathname, `${origin}/`).toString()
    : canonicalUrl(origin, locale, segment);
const socialImageUrl = new URL(ogImage, `${origin}/`).toString();
const jsonLd = buildJsonLd(origin, locale);
const t = ui(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={SEO.author} />
    <meta name="theme-color" content={SEO.themeColor} />
    <meta name="color-scheme" content="dark" />

    {!noindex && <link rel="canonical" href={pageUrl} />}
    {segment !== undefined &&
      LOCALES.map((lng) => (
        <link rel="alternate" hreflang={lng} href={canonicalUrl(origin, lng, segment)} />
      ))}
    {segment !== undefined && (
      <link rel="alternate" hreflang="x-default" href={canonicalUrl(origin, DEFAULT_LOCALE, segment)} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((lng) => lng !== locale).map((lng) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[lng]} />
    ))}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={FAVICON_SRC} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_SRC} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <SiteHeader locale={locale} segment={segment} asciiBrand={asciiBrand} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  main {
    flex: 1;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    padding: 0.5rem 0.875rem;
    background: var(--paper);
    color: var(--oxide);
    font-size: var(--step--1);
    font-weight: 500;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
