---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import BackLink from '~/components/BackLink.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { projects } from '~/data/projects';
---

<BaseLayout
  title="Tyndfed - Projects"
  description="View Tyndfed's portfolio of innovative projects including Bodegalisten, EXS Nordic, and more."
  canonical="https://tyndfed.dk/projects"
>
  <WindowChrome>
    <div class="projects-content window-scroll-region">
      <BackLink />
      <section class="projects">
        {projects.map((project, index) => (
          <ProjectCard project={project} priority={index < 2} />
        ))}
      </section>
    </div>

    <dialog class="logo-window" data-image-window aria-labelledby="logo-window-title">
      <article class="logo-window-frame">
        <header class="logo-window-header">
          <p class="logo-window-title" id="logo-window-title" data-image-window-title>EXS Nordic logo</p>
          <button type="button" class="logo-window-close" data-image-window-close aria-label="Close logo window">
            Luk
          </button>
        </header>
        <div class="logo-window-body">
          <img src="" alt="" class="logo-window-image" data-image-window-image />
        </div>
      </article>
    </dialog>
  </WindowChrome>
</BaseLayout>

<style>
  .projects {
    padding: 28px 32px 44px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    align-content: start;
  }

  @supports (content-visibility: auto) {
    .projects {
      content-visibility: auto;
      contain-intrinsic-size: 980px;
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding: 16px 14px 18px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

  }

  @media (max-width: 480px) {
    .projects {
      padding: 10px 10px 14px;
      gap: 8px;
    }

  }

  .logo-window {
    width: min(760px, calc(100vw - 28px));
    max-width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .logo-window[open] {
    inset: 0;
    margin: auto;
  }

  :global(.logo-window::backdrop) {
    background: rgba(4, 4, 7, 0.76);
    backdrop-filter: blur(4px);
  }

  .logo-window-frame {
    background: var(--bg-surface);
    border: 1px solid var(--interactive-border-hover);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 36px 60px -34px rgba(0, 0, 0, 0.8);
  }

  .logo-window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--chrome-border);
  }

  .logo-window-title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-base);
  }

  .logo-window-close {
    border: 1px solid var(--interactive-border);
    border-radius: 6px;
    background: var(--interactive-bg);
    color: var(--text-secondary);
    padding: 6px 10px;
    font-family: inherit;
    font-size: var(--font-size-xs);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .logo-window-close:hover {
    color: var(--text-primary);
    border-color: var(--interactive-border-hover);
    background: var(--interactive-bg-hover);
  }

  .logo-window-body {
    padding: 24px;
    background:
      linear-gradient(45deg, #d5d8de 25%, transparent 25%),
      linear-gradient(-45deg, #d5d8de 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #d5d8de 75%),
      linear-gradient(-45deg, transparent 75%, #d5d8de 75%),
      #eceff4;
    background-size: 30px 30px;
    background-position:
      0 0,
      0 15px,
      15px -15px,
      -15px 0;
  }

  .logo-window-image {
    display: block;
    width: 100%;
    max-height: min(68vh, 640px);
    object-fit: contain;
  }

  @media (max-width: 480px) {
    .logo-window {
      width: calc(100vw - 16px);
    }

    .logo-window-header {
      padding: 10px 12px;
    }

    .logo-window-body {
      padding: 14px;
    }
  }
</style>

<script>
  const imageWindow = document.querySelector('[data-image-window]');

  if (imageWindow instanceof HTMLDialogElement) {
    const windowTitle = imageWindow.querySelector('[data-image-window-title]');
    const windowImage = imageWindow.querySelector('[data-image-window-image]');
    const closeButton = imageWindow.querySelector('[data-image-window-close]');

    const openImageWindow = (trigger: Element) => {
      if (!(windowImage instanceof HTMLImageElement)) {
        return;
      }

      const imageSrc = trigger.getAttribute('data-image-window-src');
      if (!imageSrc) {
        return;
      }

      const imageTitle = trigger.getAttribute('data-image-window-title') ?? 'EXS Nordic logo';

      windowImage.src = imageSrc;
      windowImage.alt = imageTitle;

      if (windowTitle) {
        windowTitle.textContent = imageTitle;
      }

      if (!imageWindow.open) {
        imageWindow.showModal();
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      const trigger = target.closest('[data-image-window-trigger]');
      if (!trigger) {
        return;
      }

      event.preventDefault();
      openImageWindow(trigger);
    });

    closeButton?.addEventListener('click', () => {
      imageWindow.close();
    });

    imageWindow.addEventListener('click', (event) => {
      if (event.target === imageWindow) {
        imageWindow.close();
      }
    });
  }

  const glowCards = document.querySelectorAll('[data-card-glow]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const usesCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

  const clampChannel = (value: number) => {
    return Math.max(0, Math.min(255, Math.round(value)));
  };

  const relativeLuminance = (r: number, g: number, b: number) => {
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  };

  const saturationScore = (r: number, g: number, b: number) => {
    const rn = r / 255;
    const gn = g / 255;
    const bn = b / 255;
    const max = Math.max(rn, gn, bn);
    const min = Math.min(rn, gn, bn);

    if (max === min) {
      return 0;
    }

    const lightness = (max + min) / 2;
    const delta = max - min;
    return lightness > 0.5 ? delta / (2 - max - min) : delta / (max + min);
  };

  const brightenIfTooDark = (rgb: [number, number, number], minimumLuma = 74): [number, number, number] => {
    const luma = relativeLuminance(rgb[0], rgb[1], rgb[2]);
    if (luma >= minimumLuma) {
      return rgb;
    }

    const lift = minimumLuma - luma;
    return [clampChannel(rgb[0] + lift), clampChannel(rgb[1] + lift), clampChannel(rgb[2] + lift)];
  };

  const extractGlowColorsFromIcon = (icon: Element) => {
    if (!(icon instanceof HTMLImageElement) || !icon.complete || icon.naturalWidth === 0 || icon.naturalHeight === 0) {
      return null;
    }

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) {
      return null;
    }

    const sampleSize = 30;
    canvas.width = sampleSize;
    canvas.height = sampleSize;

    try {
      ctx.drawImage(icon, 0, 0, sampleSize, sampleSize);
    } catch {
      return null;
    }

    const { data } = ctx.getImageData(0, 0, sampleSize, sampleSize);
    let rSum = 0;
    let gSum = 0;
    let bSum = 0;
    let count = 0;
    let best: [number, number, number] = [0, 240, 255];
    let bestScore = -1;

    for (let index = 0; index < data.length; index += 4) {
      const r = data[index];
      const g = data[index + 1];
      const b = data[index + 2];
      const alpha = data[index + 3];

      if (alpha < 42) {
        continue;
      }

      rSum += r;
      gSum += g;
      bSum += b;
      count += 1;

      const sat = saturationScore(r, g, b);
      const luma = relativeLuminance(r, g, b);
      const score = sat * 1.3 + (alpha / 255) * 0.25 + (luma > 35 && luma < 220 ? 0.2 : 0);

      if (score > bestScore) {
        bestScore = score;
        best = [r, g, b];
      }
    }

    if (count === 0) {
      return null;
    }

    const average: [number, number, number] = [rSum / count, gSum / count, bSum / count];
    const dominant = bestScore > 0.2 ? best : average;
    const glow = brightenIfTooDark(dominant, 86);
    const soft = brightenIfTooDark([
      average[0] * 0.65 + glow[0] * 0.35,
      average[1] * 0.65 + glow[1] * 0.35,
      average[2] * 0.65 + glow[2] * 0.35,
    ]);

    return {
      glow: `${clampChannel(glow[0])}, ${clampChannel(glow[1])}, ${clampChannel(glow[2])}`,
      soft: `${clampChannel(soft[0])}, ${clampChannel(soft[1])}, ${clampChannel(soft[2])}`,
    };
  };

  const applyLogoGlowColors = (card: Element) => {
    if (!(card instanceof HTMLElement)) {
      return;
    }

    const icon = card.querySelector('[data-card-icon]');
    if (!(icon instanceof HTMLImageElement)) {
      return;
    }

    const apply = () => {
      const colors = extractGlowColorsFromIcon(icon);
      if (!colors) {
        return;
      }

      card.style.setProperty('--glow-rgb', colors.glow);
      card.style.setProperty('--glow-soft-rgb', colors.soft);
    };

    if (icon.complete && icon.naturalWidth > 0) {
      apply();
      return;
    }

    icon.addEventListener('load', apply, { once: true });
  };

  const resetCardGlow = (card: Element) => {
    if (!(card instanceof HTMLElement)) {
      return;
    }

    card.style.setProperty('--pointer-x', '50%');
    card.style.setProperty('--pointer-y', '30%');
  };

  glowCards.forEach((card) => {
    resetCardGlow(card);
    applyLogoGlowColors(card);

    if (!(card instanceof HTMLElement) || prefersReducedMotion || usesCoarsePointer) {
      return;
    }

    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      card.style.setProperty('--pointer-x', `${(x / rect.width) * 100}%`);
      card.style.setProperty('--pointer-y', `${(y / rect.height) * 100}%`);
    });

    card.addEventListener('pointerleave', () => {
      resetCardGlow(card);
    });
  });
</script>
