---
import type { LegalDocument } from '~/data/legal';

interface Props {
  document: LegalDocument;
}

const { document } = Astro.props;
---

<section class="legal-section">
  <h2>{document.title}</h2>
  <p class="updated">{document.updated}</p>
  {document.sections.map((section) => (
    <div>
      <h3>{section.heading}</h3>
      <p>{section.text}</p>
    </div>
  ))}
</section>

<style>
  .legal-section {
    padding: 18px 18px 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--interactive-border);
    border-radius: 8px;
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: var(--font-size-sm);
  }

  .legal-section h2 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 600;
    letter-spacing: 0.01em;
    border-bottom: 1px solid var(--chrome-border);
    padding-bottom: 10px;
    margin-bottom: 14px;
    position: relative;
  }

  .legal-section h2::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  .legal-section h3 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    font-weight: 500;
    margin-top: 16px;
    margin-bottom: 6px;
  }

  .legal-section p {
    margin-bottom: 10px;
  }

  .updated {
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .updated::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
  }

  @media (max-width: 480px) {
    .legal-section {
      padding: 12px 12px 10px;
      font-size: var(--font-size-xs);
    }

    .legal-section h2 {
      font-size: var(--font-size-base);
      margin-bottom: 12px;
    }

    .legal-section h3 {
      font-size: var(--font-size-sm);
      margin-top: 14px;
    }

    .legal-section p {
      margin-bottom: 8px;
    }
  }
</style>
