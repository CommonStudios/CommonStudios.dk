---
import BaseLayout from '~/layouts/BaseLayout.astro';
import WindowChrome from '~/components/WindowChrome.astro';
import { CANONICAL, ROUTES } from '~/config/site';
---

<BaseLayout
  title="Tyndfed — Independent studio for software & creative work"
  canonical={CANONICAL.home}
>
  <WindowChrome>
    <section class="hero shell" aria-label="Hero">
      <p class="hero-eyebrow">Independent studio · Copenhagen</p>
      <h1 class="hero-title">
        Software and creative work for brands that want clarity.
      </h1>
      <p class="hero-lede">
        Tyndfed builds websites, products and visual systems with a
        clean, editorial approach.
      </p>
      <nav class="hero-actions" aria-label="Hero actions">
        <a href={ROUTES.projects} class="hero-text-link">
          View projects
          <svg class="hero-text-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11m0 0L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:kontakt@tyndfed.dk" class="hero-text-link">
          Start a project
          <svg class="hero-text-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h11m0 0L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </nav>
    </section>
  </WindowChrome>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(36px, 5vw, 64px);
    padding-bottom: clamp(32px, 4vw, 56px);
    max-width: 640px;
    border-bottom: 1px solid var(--rule);
  }

  .hero-eyebrow {
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.5vw, 64px);
    line-height: 1;
    letter-spacing: -0.025em;
    max-width: 18ch;
    font-variation-settings: 'opsz' 48, 'SOFT' 40;
  }

  .hero-lede {
    margin-top: 14px;
    max-width: 44ch;
    color: var(--text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .hero-text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) ease;
  }

  .hero-text-link:hover {
    color: var(--text-primary);
  }

  .hero-text-link:hover .hero-text-arrow {
    transform: translateX(3px);
  }

  .hero-text-arrow {
    color: var(--accent);
    transition: transform var(--duration-fast) ease;
    flex-shrink: 0;
  }
</style>
