---
import type { Project } from '~/data/projects';
import { isLogoPreviewLink } from '~/constants/project-ui';

interface Props {
  project: Project;
  index?: number;
  priority?: boolean;
}

const { project, index = 0, priority = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const tags = project.links.map((l) => l.label).join(' · ');
---

<li class="project-row" data-project-row>
  <div class="row-grid">
    <span class="row-num">{num}</span>

    <div class="row-main">
      <h3 class="row-name">{project.name}</h3>
      <p class="row-desc">{project.description}</p>
      <ul class="row-links">
        {project.links.map((link) =>
          isLogoPreviewLink(project.name, link.label) ? (
            <li>
              <button
                type="button"
                class="row-link"
                data-image-window-trigger
                data-image-window-title={`${project.name} - ${link.label}`}
                data-image-window-src={link.url}
                aria-label={`${project.name} - ${link.label} (opens logo preview window)`}
                data-magnetic
              >
                <span class="link-arrow" aria-hidden="true">↗</span>
                <span>{link.label}</span>
              </button>
            </li>
          ) : (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} - ${link.label} (opens in a new tab)`}
                class="row-link"
                data-magnetic
              >
                <span class="link-arrow" aria-hidden="true">↗</span>
                <span>{link.label}</span>
              </a>
            </li>
          )
        )}
      </ul>
    </div>

    <p class="row-tags" aria-hidden="true">{tags}</p>

    <span class="row-icon-wrap" aria-hidden="true">
      <img
        src={project.icon}
        alt=""
        class="row-icon"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        width="80"
        height="80"
      />
    </span>
  </div>
</li>

<style>
  .project-row {
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .row-grid {
    display: grid;
    grid-template-columns: 80px 1fr 200px 80px;
    gap: 32px;
    align-items: start;
    padding: 36px 0;
    transition: padding-inline var(--duration-normal) var(--ease-out-expo);
  }

  .project-row:hover .row-grid {
    padding-inline: 8px;
  }

  /* Subtle hover wash */
  .project-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 60% at 30% 50%,
      rgba(212, 184, 122, 0.05),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--duration-normal) ease;
    pointer-events: none;
  }

  .project-row:hover::before {
    opacity: 1;
  }

  .row-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    padding-top: 12px;
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .row-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-variation-settings: 'opsz' 144, 'SOFT' 30;
    font-size: clamp(36px, 4.5vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
    transition: font-style 320ms ease, font-variation-settings 320ms ease, color var(--duration-fast) ease;
  }

  .project-row:hover .row-name {
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    color: var(--accent-strong);
  }

  .row-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 60ch;
    margin: 0;
  }

  .row-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .row-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 8px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform 280ms var(--ease-out-expo);
  }

  .row-link:hover {
    color: var(--bg-void);
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .row-link .link-arrow {
    font-family: var(--font-sans);
    font-size: 12px;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .row-link:hover .link-arrow {
    transform: translate(2px, -2px);
  }

  .row-tags {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.6;
    padding-top: 14px;
    margin: 0;
  }

  .row-icon-wrap {
    width: 80px;
    height: 80px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-elevated);
    align-self: start;
    display: block;
    transition: transform 360ms var(--ease-out-expo), border-color var(--duration-fast) ease;
  }

  .project-row:hover .row-icon-wrap {
    transform: scale(1.08) rotate(-2deg);
    border-color: var(--rule-accent);
  }

  .row-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .row-grid {
      grid-template-columns: 50px 1fr 60px;
      gap: 18px;
      padding: 24px 0;
    }
    .row-tags { display: none; }
    .row-icon-wrap { width: 60px; height: 60px; }
    .row-num { padding-top: 8px; }
    .row-name { font-size: clamp(26px, 6vw, 44px); }
    .row-desc { font-size: 14px; }
  }

  @media (max-width: 480px) {
    .row-grid {
      grid-template-columns: 40px 1fr;
      gap: 14px;
      padding: 20px 0;
    }
    .row-icon-wrap { display: none; }
    .row-name { font-size: clamp(24px, 8vw, 36px); }
    .row-desc {
      font-size: 13px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

</style>
