---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT } from '~/config/site';
import { projects } from '~/data/projects';
import { LOCALES, isLocale } from '~/i18n/constants';
import { ui } from '~/i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) {
  return Astro.redirect('/da');
}
const locale = raw;
const t = ui(locale);
const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<BaseLayout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  locale={locale}
  segment=""
  cloudSea
>
  <section class="intro wrap">
    <h1>{t.home.title}</h1>
    <p>{t.home.intro}</p>
  </section>

  <section id="work" class="section wrap" aria-labelledby="work-heading">
    <h2 id="work-heading" class="section-heading">{t.home.workHeading}</h2>
    <div class="index-head" aria-hidden="true">
      <span>{t.home.workColumns.project}</span>
      <span>{t.home.workColumns.kind}</span>
      <span>{t.home.workColumns.discipline}</span>
      <span>{t.home.workColumns.site}</span>
    </div>
    <ul class="work" role="list">
      {projects.map((project) => (
        <li class="work-item">
          <h3 class="work-name">
            <a href={project.url} rel="noopener" target="_blank">{project.name}</a>
          </h3>
          <dl class="work-meta">
            <div>
              <dt class="visually-hidden">{t.home.workColumns.kind}</dt>
              <dd>{t.home.projectKinds[project.kind]}</dd>
            </div>
            <div>
              <dt class="visually-hidden">{t.home.workColumns.discipline}</dt>
              <dd>{project.discipline[locale]}</dd>
            </div>
            <div class="work-site">
              <dt class="visually-hidden">{t.home.workColumns.site}</dt>
              <dd>{hostname(project.url)}<span aria-hidden="true"> ↗</span></dd>
            </div>
          </dl>
          <div class="work-body">
            <p>{project.description[locale]}</p>
            {project.preview && (
              <img
                class="work-preview"
                src={project.preview.src}
                width={project.preview.width}
                height={project.preview.height}
                alt={project.preview.alt[locale]}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="services-heading">
    <h2 id="services-heading" class="section-heading">{t.home.servicesHeading}</h2>
    <ul class="services" role="list">
      {t.home.services.map((service) => (
        <li>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" class="section contact wrap" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-heading">{t.home.contactHeading}</h2>
    <p class="contact-text">{t.home.contactText}</p>
    <div class="contact-actions">
      <a class="contact-email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <button
        type="button"
        class="copy"
        aria-live="polite"
        data-copy={CONTACT.email}
        data-copied-label={t.home.copiedEmail}
      >
        {t.home.copyEmail}
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const idleLabel = button.textContent ?? '';
    let resetTimer = 0;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        // Clipboard blocked: the mailto link next to the button still works.
        return;
      }
      // Hold the idle width so the shorter "copied" label doesn't shrink the button.
      button.style.minWidth = `${button.offsetWidth}px`;
      button.textContent = button.dataset.copiedLabel ?? idleLabel;
      button.dataset.state = 'copied';
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.textContent = idleLabel;
        delete button.dataset.state;
      }, 2000);
    });
  }
</script>

<style>
  .intro {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(6rem, 14vw, 11rem);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .intro p {
    max-width: var(--measure);
    margin-top: 2rem;
    color: var(--lichen);
  }

  .section {
    padding-bottom: clamp(6rem, 14vw, 11rem);
  }

  .section-heading {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--lichen);
    padding-bottom: 1.5rem;
  }

  /* --- Work: an index set like film credits. The name is the one loud
     element; type, discipline and site run in quiet columns beside it. --- */

  .index-head,
  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 6fr) repeat(3, minmax(0, 2fr));
    column-gap: 2rem;
  }

  .index-head {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--seam);
    color: var(--lichen);
    font-size: var(--step--1);
  }

  .work-item {
    position: relative;
    row-gap: 1.5rem;
    align-items: start;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--seam);
  }

  .work {
    container-type: inline-size;
  }

  .work-name {
    grid-row: span 2;
    /* Capped by the list width so the longest name (Andelsbasen) stays inside its column. */
    font-size: min(var(--step-3), 6.6cqi);
    font-weight: 600;
    line-height: 0.95;
    /* Monospace advances are fixed, so tighter tracking crowds wide letters like m and w. */
    letter-spacing: -0.02em;
  }

  .work-name a {
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  /* Stretch the name link over the whole row. */
  .work-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-item:hover .work-name a {
    color: var(--patina);
  }

  .work-name a:focus-visible {
    outline: none;
  }

  .work-name a:focus-visible::after {
    outline: 2px solid var(--patina);
    outline-offset: -2px;
  }

  .work-meta {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: subgrid;
    /* Sit on the name's cap height rather than its line box. */
    padding-top: 0.35em;
    font-size: var(--step--1);
  }

  .work-site {
    transition: color var(--fast) var(--ease);
  }

  .work-item:hover .work-site {
    color: var(--patina);
  }

  .work-body {
    grid-column: 2 / -1;
    max-width: var(--measure);
    color: var(--lichen);
  }

  .work-preview {
    width: min(16rem, 100%);
    margin-top: 2rem;
  }

  /* --- Services --- */

  .services {
    display: grid;
    /* At most two columns: four cramped columns read as a list of fragments. */
    grid-template-columns: repeat(auto-fit, minmax(max(15rem, calc((100% - 5rem) / 2)), 1fr));
    gap: clamp(3rem, 6vw, 4.5rem) 5rem;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--seam);
    list-style: none;
  }

  .services h3 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .services p {
    max-width: var(--measure);
    margin-top: 1rem;
    color: var(--lichen);
  }

  /* --- Contact --- */

  .contact .section-heading {
    font-size: var(--step-2);
    color: var(--paper);
    letter-spacing: -0.02em;
    padding-bottom: 0;
  }

  .contact-text {
    max-width: var(--measure);
    margin-top: 1.5rem;
    color: var(--lichen);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 3.5rem;
  }

  .contact-email {
    /* Monospace runs wide; shrink on narrow screens so the address stays on one line. */
    font-size: min(var(--step-2), 6vw);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration-color: var(--seam-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .contact-email:hover {
    text-decoration-color: currentColor;
  }

  .copy {
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid var(--seam-strong);
    border-radius: 999px;
    background: none;
    color: var(--paper);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition:
      border-color var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .copy:hover {
    border-color: var(--patina);
    color: var(--patina);
  }

  .copy[data-state='copied'] {
    border-color: var(--patina);
    background: var(--patina);
    color: var(--oxide);
  }

  @media (max-width: 52rem) {
    .index-head {
      display: none;
    }

    .work {
      border-top: 1px solid var(--seam);
    }

    .work-item {
      grid-template-columns: 1fr;
    }

    .work-name {
      grid-row: auto;
      font-size: var(--step-3);
    }

    .work-meta {
      grid-column: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      padding-top: 0;
      color: var(--lichen);
    }

    .work-site {
      flex-basis: 100%;
      color: var(--paper);
    }

    .work-body {
      grid-column: auto;
    }
  }
</style>
